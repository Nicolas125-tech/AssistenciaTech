@model IEnumerable<AssistenciaTech.Models.Cliente>

@{
    ViewData["Title"] = "Gestão de Clientes";
}

<div class="container-fluid mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>Gestão de Clientes</h2>
        <a asp-action="Create" class="btn btn-primary"><i class="bi bi-person-plus"></i> Novo Cliente</a>
    </div>

    @if (Context.Request.Query["erro"].Count > 0)
    {
        <div class="alert alert-danger shadow-sm border-0 rounded-4" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i> @Context.Request.Query["erro"]
        </div>
    }

    <!-- Tabela Gerencial -->
    <div class="card shadow mb-4">
        <div class="card-header py-3">
            <h6 class="m-0 font-weight-bold text-primary">Clientes Cadastrados</h6>
        </div>
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-bordered table-hover align-middle" width="100%" cellspacing="0">
                    <thead class="table-dark">
                        <tr>
                            <th>ID</th>
                            <th>Nome</th>
                            <th>CPF</th>
                            <th>Telefone</th>
                            <th>E-mail</th>
                            <th class="text-center">Ações</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td class="fw-bold">#@item.Id</td>
                                <td>@item.Nome</td>
                                <td>@item.Cpf</td>
                                <td>@item.Telefone</td>
                                <td>@item.Email</td>
                                <td class="text-center">
                                    <div class="d-inline-flex">
                                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary me-2" title="Editar">
                                            <i class="bi bi-pencil-square"></i> Editar
                                        </a>
                                        <form asp-action="Delete" asp-route-id="@item.Id" method="post" onsubmit="return confirm('Tem certeza que deseja excluir o cliente @item.Nome?');">
                                            <button type="submit" class="btn btn-sm btn-outline-danger" title="Excluir">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
