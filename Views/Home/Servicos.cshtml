@{
    ViewData["Title"] = "Tabela de Serviços";
}

<section class="workbench-stage mb-4">
    <div class="container">
        <div class="row align-items-end g-3">
            <div class="col-lg-8">
                <div class="workbench-eyebrow mb-2">
                    <i class="bi bi-tools"></i>
                    <span>Catálogo operacional de bancada</span>
                </div>
                <h1 class="h2 fw-bold mb-2">Tabela técnica de serviços e reparos</h1>
                <p class="text-muted mb-0">
                    Escopo técnico dos procedimentos executados em laboratório para notebooks, desktops e placas lógicas.
                </p>
            </div>
            <div class="col-lg-4">
                <label for="filtroCatalogoServicos" class="form-label small text-muted">Filtrar procedimento por palavra-chave</label>
                <div class="input-group">
                    <span class="input-group-text"><i class="bi bi-search"></i></span>
                    <input type="search" id="filtroCatalogoServicos" class="form-control" placeholder="Ex: BIOS, pasta térmica, Windows, BGA...">
                </div>
            </div>
        </div>
    </div>
</section>

<div class="container mb-5">
    <div class="spec-grid" id="gradeCatalogoServicos">
        <div class="spec-cell servico-item">
            <div>
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <span class="spec-code">SRV-101 · SISTEMA</span>
                    <i class="bi bi-windows text-primary fs-5"></i>
                </div>
                <h2 class="h5 fw-semibold mb-2">Formatação e Instalação</h2>
                <p class="text-muted small mb-3">
                    Instalação limpa do Windows 10 ou 11, atualização de drivers oficiais do fabricante, suíte básica de trabalho e backup íntegro de arquivos do usuário.
                </p>
            </div>
            <div class="d-flex justify-content-between align-items-center pt-3 border-top border-secondary">
                <span class="spec-price">A partir de R$ 120</span>
                <span class="font-monospace small text-muted">Prazo médio: 24h</span>
            </div>
        </div>

        <div class="spec-cell servico-item">
            <div>
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <span class="spec-code">SRV-102 · HARDWARE</span>
                    <i class="bi bi-cpu-fill text-primary fs-5"></i>
                </div>
                <h2 class="h5 fw-semibold mb-2">Montagem de PC e Estações</h2>
                <p class="text-muted small mb-3">
                    Dimensionamento de fontes e componentes, montagem estruturada com organização de cabos, atualização de perfil XMP/EXPO e teste térmico sob carga.
                </p>
            </div>
            <div class="d-flex justify-content-between align-items-center pt-3 border-top border-secondary">
                <span class="spec-price">Sob especificação</span>
                <span class="font-monospace small text-muted">Prazo médio: 48h</span>
            </div>
        </div>

        <div class="spec-cell servico-item">
            <div>
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <span class="spec-code">SRV-103 · SEGURANÇA</span>
                    <i class="bi bi-shield-shaded text-primary fs-5"></i>
                </div>
                <h2 class="h5 fw-semibold mb-2">Remoção de Malware e Otimização</h2>
                <p class="text-muted small mb-3">
                    Varredura fora do sistema operacional para erradicação de trojans, adwares e processos persistentes, preservando dados e corrigindo registros corrompidos.
                </p>
            </div>
            <div class="d-flex justify-content-between align-items-center pt-3 border-top border-secondary">
                <span class="spec-price">A partir de R$ 110</span>
                <span class="font-monospace small text-muted">Prazo médio: 24h</span>
            </div>
        </div>

        <div class="spec-cell servico-item">
            <div>
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <span class="spec-code">SRV-104 · ELETRÔNICA</span>
                    <i class="bi bi-motherboard text-primary fs-5"></i>
                </div>
                <h2 class="h5 fw-semibold mb-2">Reparo de Placa-Mãe</h2>
                <p class="text-muted small mb-3">
                    Análise com esquema elétrico, localização de curtos em linhas primárias/secundárias, troca de componentes SMD, regravação de BIOS e reconstrução de trilhas.
                </p>
            </div>
            <div class="d-flex justify-content-between align-items-center pt-3 border-top border-secondary">
                <span class="spec-price">Sob orçamento</span>
                <span class="font-monospace small text-muted">Triagem: 2 a 4 dias</span>
            </div>
        </div>

        <div class="spec-cell servico-item">
            <div>
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <span class="spec-code">SRV-105 · TÉRMICA</span>
                    <i class="bi bi-fan text-primary fs-5"></i>
                </div>
                <h2 class="h5 fw-semibold mb-2">Limpeza Preventiva</h2>
                <p class="text-muted small mb-3">
                    Desmontagem completa do conjunto dissipador, desobstrução de aletas, lubrificação de cooler e aplicação de composto térmico de alta condutividade.
                </p>
            </div>
            <div class="d-flex justify-content-between align-items-center pt-3 border-top border-secondary">
                <span class="spec-price">A partir de R$ 150</span>
                <span class="font-monospace small text-muted">Prazo médio: 24h</span>
            </div>
        </div>

        <div class="spec-cell servico-item">
            <div>
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <span class="spec-code">SRV-106 · ESTRUTURA</span>
                    <i class="bi bi-laptop text-primary fs-5"></i>
                </div>
                <h2 class="h5 fw-semibold mb-2">Conserto de Carcaça e Dobradiças</h2>
                <p class="text-muted small mb-3">
                    Reconstrução de buchas de ancoragem em resina estrutural, alívio de pressão mecânica nas hastes metálicas e alinhamento de tampa e moldura da tela.
                </p>
            </div>
            <div class="d-flex justify-content-between align-items-center pt-3 border-top border-secondary">
                <span class="spec-price">Sob avaliação</span>
                <span class="font-monospace small text-muted">Prazo médio: 48h</span>
            </div>
        </div>
    </div>

    <div class="workbench-panel p-4 mt-4 d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3">
        <div>
            <div class="fw-semibold">Equipamento já deu entrada na oficina?</div>
            <div class="text-muted small">Consulte o andamento pelo número da Ordem de Serviço ou acesse todos os seus reparos vinculados ao seu e-mail.</div>
        </div>
        <div class="d-flex flex-wrap gap-2">
            <a asp-controller="Consulta" asp-action="Index" class="btn btn-primary">
                <i class="bi bi-search me-1"></i> Consultar minha OS
            </a>
            <a href="https://wa.me/5549999999999?text=Ol%C3%A1,%20gostaria%20de%20agendar%20um%20servi%C3%A7o%20t%C3%A9cnico." target="_blank" rel="noopener noreferrer" class="btn btn-outline-secondary">
                <i class="bi bi-whatsapp me-1"></i> Solicitar avaliação
            </a>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        (function () {
            var input = document.getElementById('filtroCatalogoServicos');
            if (!input) return;
            input.addEventListener('input', function () {
                var termo = (input.value || '').toLowerCase().trim();
                document.querySelectorAll('#gradeCatalogoServicos .servico-item').forEach(function (item) {
                    var texto = (item.textContent || '').toLowerCase();
                    item.style.display = (!termo || texto.indexOf(termo) !== -1) ? '' : 'none';
                });
            });
        })();
    </script>
}
