@{
    Layout = "_Layout";
    ViewData["Title"] = "Autenticando...";
}

<div class="container mt-5 pt-5 mb-5 pb-5">
    <div class="row justify-content-center">
        <div class="col-md-6 col-lg-5">
            <div class="card shadow-lg border-0 rounded-4 overflow-hidden">
                <div class="card-header bg-dark text-white text-center py-4">
                    <h3 class="mb-0 fw-bold"><i class="bi bi-google"></i> Autenticação Neon</h3>
                    <p class="mb-0 small text-white-50 mt-1">Conectando sua conta Google ao sistema...</p>
                </div>
                <div class="card-body p-5 text-center" id="statusContainer">
                    <div id="loader">
                        <div class="spinner-border text-primary" style="width: 3rem; height: 3rem;" role="status">
                            <span class="visually-hidden">Carregando...</span>
                        </div>
                        <p class="mt-4 mb-0 text-muted">Verificando suas credenciais de segurança...</p>
                    </div>

                    <div id="errorArea" class="d-none">
                        <div class="alert alert-danger rounded-3 p-3 mb-4" role="alert">
                            <i class="bi bi-exclamation-triangle-fill fs-4 d-block mb-2"></i>
                            <span id="errorMessage">Ocorreu um erro ao processar sua autenticação.</span>
                        </div>
                        <div class="d-grid gap-2">
                            <a href="/Home/Index" class="btn btn-outline-secondary">
                                <i class="bi bi-house"></i> Voltar para o Início
                            </a>
                            <a href="/Consulta" class="btn btn-primary">
                                <i class="bi bi-search"></i> Área do Cliente
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", async function() {
            const loader = document.getElementById("loader");
            const errorArea = document.getElementById("errorArea");
            const errorMessage = document.getElementById("errorMessage");

            try {
                // 1. Buscar a sessão ativa no servidor Neon Auth
                const neonSessionUrl = "https://ep-raspy-violet-apzb0bnc.neonauth.c-7.us-east-1.aws.neon.tech/neondb/auth/get-session";
                
                const response = await fetch(neonSessionUrl, {
                    method: "GET",
                    headers: {
                        "Accept": "application/json"
                    },
                    credentials: "include" // Importante: envia os cookies cross-domain do Neon Auth
                });

                if (!response.ok) {
                    throw new Error("Não foi possível recuperar a sessão do Neon Auth. Por favor, tente novamente.");
                }

                const sessionData = await response.json();
                
                if (!sessionData || !sessionData.session || !sessionData.session.token) {
                    throw new Error("Você não possui uma sessão ativa. Efetue o login com o Google primeiro.");
                }

                const token = sessionData.session.token;

                // 2. Enviar o token para verificar e iniciar a sessão no ASP.NET local
                const verifyResponse = await fetch("/Account/VerifyNeonSession", {
                    method: "POST",
                    headers: {
                        "Content-Type": "application/json"
                    },
                    body: JSON.stringify({ token: token })
                });

                if (!verifyResponse.ok) {
                    throw new Error("Erro na comunicação com o servidor principal.");
                }

                const result = await verifyResponse.json();

                if (result.success && result.redirectUrl) {
                    // Redireciona o usuário autenticado
                    window.location.href = result.redirectUrl;
                } else {
                    throw new Error(result.message || "Erro desconhecido durante a autenticação.");
                }

            } catch (err) {
                // Exibe a mensagem de erro
                loader.classList.add("d-none");
                errorArea.classList.remove("d-none");
                errorMessage.textContent = err.message;
            }
        });
    </script>
}
