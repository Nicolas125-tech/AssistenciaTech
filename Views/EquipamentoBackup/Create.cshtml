@model AssistenciaTech.Models.EquipamentoBackup

@{
    ViewData["Title"] = "Novo Equipamento Backup · TechOS";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-lg-6">
            <div class="mb-3 d-flex justify-content-between align-items-center">
                <span class="workbench-eyebrow">
                    <i class="bi bi-laptop"></i>
                    <span>Parque de Reserva</span>
                </span>
                <a asp-action="Index" class="small text-muted text-decoration-none">
                    <i class="bi bi-arrow-left me-1"></i> Voltar à lista
                </a>
            </div>

            <div class="card workbench-panel">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <h1 class="h5 mb-0 fw-semibold">Cadastrar Máquina de Backup</h1>
                    <span class="font-monospace small text-muted">OFICINA</span>
                </div>
                <div class="card-body p-4">
                    <form asp-action="Create" method="post">
                        @Html.AntiForgeryToken()
                        <div class="mb-3">
                            <label asp-for="Descricao" class="form-label">Descrição / Modelo</label>
                            <input asp-for="Descricao" class="form-control" placeholder="Ex: Notebook Dell Latitude 3420 i5 8GB" required />
                        </div>
                        <div class="mb-3">
                            <label asp-for="NumeroSerie" class="form-label">Número de série / Patrimônio</label>
                            <input asp-for="NumeroSerie" class="form-control font-monospace" placeholder="S/N ou etiqueta interna" />
                        </div>
                        <div class="mb-4 form-check">
                            <input asp-for="Disponivel" class="form-check-input" />
                            <label asp-for="Disponivel" class="form-check-label">Equipamento disponível na oficina para empréstimo</label>
                        </div>
                        <div class="d-flex justify-content-between align-items-center pt-3 border-top border-secondary">
                            <a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
                            <button type="submit" class="btn btn-primary">
                                <i class="bi bi-check2 me-1"></i> Salvar Máquina
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
