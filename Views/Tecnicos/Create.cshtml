@model AssistenciaTech.DTOs.TecnicoCreateDto

@{
    ViewData["Title"] = "Novo Técnico · TechOS";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-lg-6">
            <div class="mb-3 d-flex justify-content-between align-items-center">
                <span class="workbench-eyebrow">
                    <i class="bi bi-person-plus"></i>
                    <span>Equipe</span>
                </span>
                <a asp-action="Index" class="small text-muted text-decoration-none">
                    <i class="bi bi-arrow-left me-1"></i> Voltar à lista
                </a>
            </div>

            <div class="card workbench-panel">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <h1 class="h5 mb-0 fw-semibold">Cadastrar Técnico</h1>
                    <span class="font-monospace small text-muted">OFICINA</span>
                </div>
                <div class="card-body p-4">
                    <form asp-action="Create" method="post">
                        @Html.AntiForgeryToken()
                        <div class="mb-3">
                            <label asp-for="Nome" class="form-label">Nome do profissional</label>
                            <input asp-for="Nome" class="form-control" required />
                        </div>
                        <div class="mb-3">
                            <label asp-for="PercentualComissao" class="form-label">Comissão por serviço (%)</label>
                            <input asp-for="PercentualComissao" class="form-control font-monospace" type="number" step="0.01" min="0" max="100" />
                        </div>
                        <div class="mb-4 form-check">
                            <input asp-for="Ativo" class="form-check-input" />
                            <label asp-for="Ativo" class="form-check-label">Profissional ativo na bancada</label>
                        </div>
                        <div class="d-flex justify-content-between align-items-center pt-3 border-top border-secondary">
                            <a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
                            <button type="submit" class="btn btn-primary">
                                <i class="bi bi-check2 me-1"></i> Salvar Técnico
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
