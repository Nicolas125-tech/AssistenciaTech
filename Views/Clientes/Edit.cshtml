@model AssistenciaTech.DTOs.ClienteUpdateDto

@{
    ViewData["Title"] = $"Editar Cliente #{Model.Id} · TechOS";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="mb-3 d-flex justify-content-between align-items-center">
                <span class="workbench-eyebrow">
                    <i class="bi bi-pencil-square"></i>
                    <span>Atualização de Cadastro</span>
                </span>
                <a asp-action="Index" class="small text-muted text-decoration-none">
                    <i class="bi bi-arrow-left me-1"></i> Voltar para a lista
                </a>
            </div>

            <div class="card workbench-panel">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <h1 class="h5 mb-0 fw-semibold">Editar Cliente <span class="font-monospace text-primary">#@Model.Id</span></h1>
                    <span class="font-monospace small text-muted">OFICINA</span>
                </div>
                <div class="card-body p-4">
                    <form asp-action="Edit" method="post">
                        @Html.AntiForgeryToken()
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small mb-3"></div>
                        <input type="hidden" asp-for="Id" />

                        <div class="mb-3">
                            <label asp-for="Nome" class="form-label">Nome completo</label>
                            <input asp-for="Nome" class="form-control" required />
                            <span asp-validation-for="Nome" class="text-danger small"></span>
                        </div>

                        <div class="row g-3 mb-3">
                            <div class="col-md-6">
                                <label asp-for="Cpf" class="form-label">CPF</label>
                                <input asp-for="Cpf" class="form-control font-monospace" required maxlength="14" />
                                <span asp-validation-for="Cpf" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="Telefone" class="form-label">Telefone / WhatsApp</label>
                                <input asp-for="Telefone" class="form-control font-monospace" required />
                                <span asp-validation-for="Telefone" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Email" class="form-label">E-mail</label>
                            <input asp-for="Email" class="form-control" type="email" />
                            <span asp-validation-for="Email" class="text-danger small"></span>
                        </div>

                        <div class="mb-4">
                            <label asp-for="TelegramChatId" class="form-label">Telegram Chat ID</label>
                            <input asp-for="TelegramChatId" class="form-control font-monospace mb-2" placeholder="ID numérico ou preenchimento via link" />
                            <span asp-validation-for="TelegramChatId" class="text-danger small"></span>

                            <div class="p-3 workbench-panel border-secondary rounded">
                                <div class="small fw-semibold text-primary mb-1">
                                    <i class="bi bi-telegram me-1"></i> Vincular notificações automáticas via Telegram
                                </div>
                                <p class="small text-muted mb-2">Envie o link abaixo para o cliente no WhatsApp. Ao clicar em 'Iniciar', o bot registrará o ID dele automaticamente.</p>
                                <div class="input-group">
                                    <input type="text" id="telegramLink" class="form-control form-control-sm font-monospace text-primary" value="https://t.me/TechOSaviso_bot?start=@Model.Id" readonly />
                                    <button class="btn btn-outline-secondary btn-sm" type="button" onclick="copiarLink()">Copiar Link</button>
                                </div>
                            </div>
                        </div>

                        <div class="d-flex justify-content-between align-items-center pt-3 border-top border-secondary">
                            <a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
                            <button type="submit" class="btn btn-primary">
                                <i class="bi bi-check2 me-1"></i> Salvar Alterações
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function copiarLink() {
            var copyText = document.getElementById("telegramLink");
            copyText.select();
            copyText.setSelectionRange(0, 99999);
            navigator.clipboard.writeText(copyText.value).then(function () {
                alert("Link do Telegram copiado para a área de transferência!");
            });
        }
    </script>
}
