@model AssistenciaTech.Models.OrdemServico

@{
    ViewData["Title"] = "Nova Ordem de Serviço";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow">
                <div class="card-header bg-primary text-white">
                    <h5 class="mb-0">Dar Entrada em Equipamento</h5>
                </div>
                <div class="card-body">
                    <form asp-action="Create">
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                        <div class="row mb-3">
                            <div class="col-md-12 form-group">
                                <label asp-for="ClienteId" class="form-label fw-bold">Cliente</label>
                                <select asp-for="ClienteId" class="form-select" asp-items="ViewBag.Clientes" required>
                                    <option value="">-- Selecione o Cliente --</option>
                                </select>
                                <span asp-validation-for="ClienteId" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="row mb-3">
                            <div class="col-md-12 form-group">
                                <label asp-for="Equipamento" class="form-label fw-bold">Equipamento</label>
                                <input asp-for="Equipamento" class="form-control" placeholder="Ex: Notebook Dell Inspiron 15" required />
                                <span asp-validation-for="Equipamento" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="row mb-3">
                            <div class="col-md-12 form-group">
                                <label asp-for="ProblemaRelatado" class="form-label fw-bold">Problema Relatado</label>
                                <textarea asp-for="ProblemaRelatado" class="form-control" rows="3" placeholder="Descreva o defeito informado pelo cliente" required></textarea>
                                <span asp-validation-for="ProblemaRelatado" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="row mb-3">
                            <div class="col-md-6 form-group">
                                <label asp-for="Status" class="form-label fw-bold">Status Inicial</label>
                                <select asp-for="Status" class="form-select">
                                    <option value="Recebido" selected>Recebido</option>
                                    <option value="Em Análise">Em Análise</option>
                                </select>
                                <span asp-validation-for="Status" class="text-danger"></span>
                            </div>
                            <div class="col-md-6 form-group">
                                <label asp-for="ValorOrcamento" class="form-label fw-bold">Orçamento Prévio (R$)</label>
                                <input asp-for="ValorOrcamento" type="number" step="0.01" class="form-control" value="0.00" />
                                <span asp-validation-for="ValorOrcamento" class="text-danger"></span>
                            </div>
                        </div>

                        <hr />
                        <div class="d-flex justify-content-between">
                            <a asp-action="Index" class="btn btn-secondary">Voltar ao Painel</a>
                            <button type="submit" class="btn btn-success"><i class="bi bi-save"></i> Salvar Ordem</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
