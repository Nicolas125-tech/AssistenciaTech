@model AssistenciaTech.DTOs.ClienteCreateDto

@{
    ViewData["Title"] = "Novo Cliente · TechOS";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="mb-3 d-flex justify-content-between align-items-center">
                <span class="workbench-eyebrow">
                    <i class="bi bi-person-plus"></i>
                    <span>Cadastro</span>
                </span>
                <a asp-action="Index" class="small text-muted text-decoration-none">
                    <i class="bi bi-arrow-left me-1"></i> Voltar para a lista
                </a>
            </div>

            <div class="card workbench-panel">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <h1 class="h5 mb-0 fw-semibold">Cadastrar Novo Cliente</h1>
                    <span class="font-monospace small text-muted">OFICINA</span>
                </div>
                <div class="card-body p-4">
                    <form asp-action="Create" method="post">
                        @Html.AntiForgeryToken()
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small mb-3"></div>

                        <div class="mb-3">
                            <label asp-for="Nome" class="form-label">Nome completo</label>
                            <input asp-for="Nome" class="form-control" placeholder="Nome completo do titular" required />
                            <span asp-validation-for="Nome" class="text-danger small"></span>
                        </div>

                        <div class="row g-3 mb-3">
                            <div class="col-md-6">
                                <label asp-for="Cpf" class="form-label">CPF</label>
                                <input asp-for="Cpf" class="form-control font-monospace" placeholder="000.000.000-00" required maxlength="14" />
                                <span asp-validation-for="Cpf" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="Telefone" class="form-label">Telefone / WhatsApp</label>
                                <input asp-for="Telefone" class="form-control font-monospace" placeholder="(00) 00000-0000" required />
                                <span asp-validation-for="Telefone" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Email" class="form-label">E-mail</label>
                            <input asp-for="Email" class="form-control" type="email" placeholder="cliente@exemplo.com" />
                            <span asp-validation-for="Email" class="text-danger small"></span>
                        </div>

                        <div class="mb-4">
                            <label asp-for="TelegramChatId" class="form-label">Telegram Chat ID (opcional)</label>
                            <input asp-for="TelegramChatId" class="form-control font-monospace" placeholder="Ex: 123456789" />
                            <span asp-validation-for="TelegramChatId" class="text-danger small"></span>
                        </div>

                        <div class="d-flex justify-content-between align-items-center pt-3 border-top border-secondary">
                            <a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
                            <button type="submit" class="btn btn-primary">
                                <i class="bi bi-check2 me-1"></i> Salvar Cliente
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
