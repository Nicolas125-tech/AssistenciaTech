@model AssistenciaTech.Models.Tecnico
@{
    ViewData["Title"] = "Editar Técnico";
}
<div class="container mt-5">
    <div class="card shadow">
        <div class="card-header bg-warning text-dark"><h5>Editar Técnico</h5></div>
        <div class="card-body">
            <form asp-action="Edit">
                <input type="hidden" asp-for="Id" />
                <div class="mb-3">
                    <label asp-for="Nome" class="form-label fw-bold">Nome</label>
                    <input asp-for="Nome" class="form-control" required />
                </div>
                <div class="mb-3">
                    <label asp-for="PercentualComissao" class="form-label fw-bold">Comissão (%)</label>
                    <input asp-for="PercentualComissao" class="form-control" type="number" step="0.01" />
                </div>
                <div class="mb-3 form-check">
                    <input asp-for="Ativo" class="form-check-input" />
                    <label asp-for="Ativo" class="form-check-label fw-bold">Ativo</label>
                </div>
                <button type="submit" class="btn btn-warning">Atualizar</button>
                <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
            </form>
        </div>
    </div>
</div>
