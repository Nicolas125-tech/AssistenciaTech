@{
    ViewData["Title"] = "Consultar Ordem de Serviço";
    string telaPreferida = Context.Request.Cookies["TechOS_TelaInicial"] ?? "Bancada";
}

<div class="container mt-4 mt-lg-5">
    <div class="row justify-content-center">
        <div class="col-md-7 col-lg-5">
            <div class="mb-3 d-flex justify-content-between align-items-center">
                <span class="workbench-eyebrow">
                    <i class="bi bi-upc-scan"></i>
                    <span>Terminal de Rastreamento</span>
                </span>
                <a asp-controller="Home" asp-action="Index" asp-route-tela="Bancada" class="small text-muted text-decoration-none">
                    <i class="bi bi-grid-1x2 me-1"></i> Ir para a Bancada
                </a>
            </div>

            <div class="card workbench-panel">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <h1 class="h5 mb-0 fw-semibold">Consultar Ordem de Serviço</h1>
                    <span class="font-monospace small text-muted">TECH-OS</span>
                </div>
                <div class="card-body p-4">
                    <p class="text-muted small mb-4">
                        Informe o número impresso no comprovante de entrada e o CPF do titular para visualizar o laudo técnico e a etapa atual do equipamento.
                    </p>

                    @if (!ViewData.ModelState.IsValid)
                    {
                        <div class="alert alert-danger py-2 small">
                            @Html.ValidationSummary(false, "", new { @class = "mb-0" })
                        </div>
                    }

                    <form asp-controller="Consulta" asp-action="Status" method="post">
                        <div class="mb-3">
                            <label for="numeroOS" class="form-label">Número da OS</label>
                            <div class="input-group">
                                <span class="input-group-text font-monospace">#</span>
                                <input type="number" class="form-control font-monospace" id="numeroOS" name="numeroOS" value="@ViewBag.NumeroOS" placeholder="Ex: 1024" min="1" required>
                            </div>
                        </div>

                        <div class="mb-4">
                            <label for="cpf" class="form-label">CPF do Cliente</label>
                            <input type="text" class="form-control font-monospace" id="cpf" name="cpf" placeholder="000.000.000-00" required maxlength="14">
                        </div>

                        <div class="d-grid gap-2">
                            <button type="submit" class="btn btn-primary py-2">
                                <i class="bi bi-search me-1"></i> Consultar Status
                            </button>
                            <a asp-controller="Account" asp-action="LoginCliente" class="btn btn-outline-secondary py-2">
                                <i class="bi bi-envelope-at me-1"></i> Receber link de acesso por e-mail
                            </a>
                        </div>
                    </form>
                </div>
                <div class="card-footer px-4 py-2 d-flex justify-content-between align-items-center small">
                    <span class="text-muted">Tela padrão ao abrir o site:</span>
                    <form asp-controller="Home" asp-action="DefinirTelaInicial" method="post" class="d-inline">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="returnUrl" value="/Consulta" />
                        @if (telaPreferida == "Consulta")
                        {
                            <button type="submit" name="telaInicial" value="Bancada" class="btn btn-link btn-sm p-0 text-decoration-none text-primary">
                                Alterar para Bancada Completa
                            </button>
                        }
                        else
                        {
                            <button type="submit" name="telaInicial" value="Consulta" class="btn btn-link btn-sm p-0 text-decoration-none text-primary">
                                Fixar esta tela como inicial
                            </button>
                        }
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
