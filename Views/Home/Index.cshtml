@{
    ViewData["Title"] = "Página Inicial";
}

<!-- Hero Section -->
<div class="bg-dark text-white text-center py-5 mb-5 shadow-sm">
    <div class="container py-5">
        <h1 class="display-4 fw-bold mb-3">Seu PC e Notebook em Boas Mãos</h1>
        <p class="lead mb-4 fw-light text-white-50">Agilidade, confiança e preço justo. Especialistas em hardware e software.</p>
        <div class="d-grid gap-2 d-sm-flex justify-content-sm-center">
            <a asp-controller="Consulta" asp-action="Index" class="btn btn-primary btn-lg px-4 gap-3">Consultar minha OS <i class="bi bi-search"></i></a>
            <a href="https://wa.me/5543984445767" target="_blank" class="btn btn-success btn-lg px-4 gap-3"><i class="bi bi-whatsapp"></i> Fale pelo WhatsApp</a>
            <a asp-controller="Home" asp-action="Servicos" class="btn btn-outline-light btn-lg px-4">Ver Serviços</a>
        </div>
    </div>
</div>

<div class="container">
    <!-- Seção de Cards (Serviços Principais) -->
    <div class="row g-4 mb-5 pb-5 border-bottom">
        <div class="col-12 text-center mb-3">
            <h2 class="fw-bold">Nossos Serviços Principais</h2>
            <p class="text-muted">Soluções rápidas e eficientes para o seu equipamento.</p>
        </div>

        @foreach (var servico in ViewBag.ServicosHome)
        {
            <div class="col-md-4">
                <div class="card h-100 shadow-sm border-0 rounded-4 text-center p-3 transition-hover">
                    <div class="card-body">
                        <div class="display-4 text-primary mb-3">
                            <i class="bi @servico.Icone"></i>
                        </div>
                        <h4 class="card-title fw-bold">@servico.Titulo</h4>
                        <p class="card-text text-muted mt-3">@servico.Descricao</p>
                    </div>
                    <div class="card-footer bg-transparent border-0 pb-3">
                        <span class="badge bg-light text-dark border fs-6 p-2">@servico.Preco</span>
                    </div>
                </div>
            </div>
        }
    </div>

    <!-- Seção Por que nos escolher? -->
    <div class="row align-items-center mb-5 pb-4">
        <div class="col-md-6 mb-4 mb-md-0">
            <h2 class="fw-bold mb-4">Por que nos escolher?</h2>
            
            <div class="d-flex align-items-start mb-4">
                <div class="text-primary me-3 fs-3"><i class="bi bi-check-circle-fill"></i></div>
                <div>
                    <h5 class="fw-bold mb-1">Orçamento Grátis</h5>
                    <p class="text-muted mb-0">Traga seu aparelho, analisamos o defeito sem custo algum de avaliação.</p>
                </div>
            </div>

            <div class="d-flex align-items-start mb-4">
                <div class="text-primary me-3 fs-3"><i class="bi bi-shield-check"></i></div>
                <div>
                    <h5 class="fw-bold mb-1">Peças Originais e Garantia</h5>
                    <p class="text-muted mb-0">Trabalhamos com fornecedores de confiança e oferecemos garantia em todos os serviços.</p>
                </div>
            </div>

            <div class="d-flex align-items-start">
                <div class="text-primary me-3 fs-3"><i class="bi bi-person-badge"></i></div>
                <div>
                    <h5 class="fw-bold mb-1">Técnicos Especializados</h5>
                    <p class="text-muted mb-0">Profissionais atualizados com as últimas tecnologias do mercado.</p>
                </div>
            </div>
        </div>
        <div class="col-md-6 text-center">
            <!-- Um placeholder para imagem ilustrativa da assistência -->
            <div class="bg-light rounded-4 p-5 shadow-sm d-flex justify-content-center align-items-center" style="min-height: 350px;">
                <div class="text-muted">
                    <i class="bi bi-cpu display-1"></i>
                    <p class="mt-3 fw-bold">Assistência Técnica Especializada</p>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    /* Pequeno efeito visual para os cards */
    .transition-hover {
        transition: transform 0.3s ease, box-shadow 0.3s ease;
    }
    .transition-hover:hover {
        transform: translateY(-5px);
        box-shadow: 0 .5rem 1rem rgba(0,0,0,.15)!important;
    }
</style>
