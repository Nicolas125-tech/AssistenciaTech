@model AssistenciaTech.DTOs.ClienteUpdateDto

@{
    ViewData["Title"] = "Editar Cliente";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow">
                <div class="card-header bg-primary text-white">
                    <h5 class="mb-0">Editar Cliente - #@Model.Id</h5>
                </div>
                <div class="card-body">
                    <form asp-action="Edit">
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                        <input type="hidden" asp-for="Id" />

                        <div class="row mb-3">
                            <div class="col-md-12 form-group">
                                <label asp-for="Nome" class="form-label fw-bold">Nome</label>
                                <input asp-for="Nome" class="form-control" required />
                                <span asp-validation-for="Nome" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="row mb-3">
                            <div class="col-md-6 form-group">
                                <label asp-for="Cpf" class="form-label fw-bold">CPF</label>
                                <input asp-for="Cpf" class="form-control" required />
                                <span asp-validation-for="Cpf" class="text-danger"></span>
                            </div>
                            <div class="col-md-6 form-group">
                                <label asp-for="Telefone" class="form-label fw-bold">Telefone</label>
                                <input asp-for="Telefone" class="form-control" required />
                                <span asp-validation-for="Telefone" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="row mb-3">
                            <div class="col-md-12 form-group">
                                <label asp-for="Email" class="form-label fw-bold">E-mail</label>
                                <input asp-for="Email" class="form-control" type="email" />
                                <span asp-validation-for="Email" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="row mb-3">
                            <div class="col-md-12 form-group">
                                <label asp-for="TelegramChatId" class="form-label fw-bold">Telegram Chat ID (Automático)</label>
                                <div class="input-group">
                                    <input asp-for="TelegramChatId" class="form-control" placeholder="Deixe em branco, o cliente preencherá ao clicar no link abaixo..." />
                                </div>
                                <span asp-validation-for="TelegramChatId" class="text-danger"></span>
                                
                                <div class="mt-3 p-3 bg-light border rounded">
                                    <label class="form-label fw-bold text-success"><i class="bi bi-telegram"></i> Automatizar via Link</label>
                                    <p class="small text-muted mb-2">Envie este link para o cliente no WhatsApp. Quando ele clicar e der 'Start', o sistema salvará o ID automaticamente!</p>
                                    
                                    <div class="input-group">
                                        <input type="text" id="telegramLink" class="form-control form-control-sm text-primary" value="https://t.me/TechOSaviso_bot?start=@Model.Id" readonly />
                                        <button class="btn btn-outline-secondary btn-sm" type="button" onclick="copiarLink()">Copiar Link</button>
                                    </div>
                                    <small class="text-muted mt-1 d-block">O cliente só precisa clicar em 'Começar' ou 'Start' no Telegram.</small>
                                </div>
                            </div>
                        </div>

                        <script>
                            function copiarLink() {
                                var copyText = document.getElementById("telegramLink");
                                copyText.select();
                                document.execCommand("copy");
                                alert("Link copiado! Cole no WhatsApp do cliente.");
                            }
                        </script>

                        <hr />
                        <div class="d-flex justify-content-between">
                            <a asp-action="Index" class="btn btn-secondary">Voltar</a>
                            <button type="submit" class="btn btn-success"><i class="bi bi-save"></i> Atualizar Cliente</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="~/Views/Shared/_ValidationScriptsPartial.cshtml" />
}
