@model IEnumerable<AssistenciaTech.Models.Cliente>

@{
    ViewData["Title"] = "Gestão de Clientes · TechOS";
}

<div class="container-fluid mt-4 px-lg-4">
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-2">
        <div>
            <div class="d-flex align-items-center gap-2 mb-1">
                <span class="workbench-eyebrow">
                    <i class="bi bi-people"></i>
                    <span>Base Cadastral</span>
                </span>
                <span class="badge bg-secondary font-monospace">@Model.Count() cliente(s)</span>
            </div>
            <h1 class="h3 mb-0 fw-bold">Gestão de Clientes</h1>
        </div>
        <div class="d-flex flex-wrap gap-2">
            <a asp-action="Create" class="btn btn-primary">
                <i class="bi bi-person-plus me-1"></i> Novo Cliente
            </a>
        </div>
    </div>

    @if (Context.Request.Query["erro"].Count > 0)
    {
        <div class="alert alert-danger py-2 mb-4" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i> @Context.Request.Query["erro"]
        </div>
    }

    <div class="card workbench-panel mb-4">
        <div class="card-body py-3">
            <div class="row g-2 align-items-center">
                <div class="col-md-6 col-sm-12">
                    <div class="input-group">
                        <span class="input-group-text"><i class="bi bi-search"></i></span>
                        <input type="search" id="filtroClientes" class="form-control font-monospace" placeholder="Buscar por nome, CPF, telefone ou e-mail...">
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="card workbench-panel overflow-hidden">
        <div class="card-header d-flex justify-content-between align-items-center">
            <span class="fw-semibold"><i class="bi bi-person-lines-fill text-primary me-2"></i>Clientes Cadastrados</span>
            <span class="font-monospace small text-muted">TABELA GERAL</span>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0" id="tabelaClientes">
                    <thead>
                        <tr>
                            <th class="ps-4">ID</th>
                            <th>Nome do Cliente</th>
                            <th>CPF</th>
                            <th>Telefone / WhatsApp</th>
                            <th>E-mail</th>
                            <th class="text-end pe-4">Ações</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!Model.Any())
                        {
                            <tr>
                                <td colspan="6" class="text-center py-5 text-muted">
                                    <i class="bi bi-people fs-2 d-block mb-2"></i>
                                    <div class="fw-semibold">Nenhum cliente cadastrado</div>
                                    <p class="small mb-3">Cadastre o primeiro cliente para vincular novas ordens de serviço.</p>
                                    <a asp-action="Create" class="btn btn-sm btn-primary"><i class="bi bi-person-plus me-1"></i> Cadastrar Primeiro Cliente</a>
                                </td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var item in Model)
                            {
                                <tr class="cliente-linha">
                                    <td class="ps-4 font-monospace fw-semibold">#@item.Id</td>
                                    <td>
                                        <span class="fw-semibold text-main">@item.Nome</span>
                                    </td>
                                    <td class="font-monospace small text-muted">
                                        @(string.IsNullOrWhiteSpace(item.Cpf) ? "Não informado" : item.Cpf)
                                    </td>
                                    <td>
                                        @if (!string.IsNullOrWhiteSpace(item.Telefone))
                                        {
                                            var telLimpo = new string(item.Telefone.Where(char.IsDigit).ToArray());
                                            <div class="d-inline-flex align-items-center gap-2">
                                                <span class="font-monospace small">@item.Telefone</span>
                                                <a href="https://wa.me/55@telLimpo" target="_blank" rel="noopener noreferrer" class="text-success small" title="Conversar no WhatsApp">
                                                    <i class="bi bi-whatsapp"></i>
                                                </a>
                                            </div>
                                        }
                                        else
                                        {
                                            <span class="small text-muted">Não informado</span>
                                        }
                                    </td>
                                    <td class="font-monospace small text-muted">
                                        @(string.IsNullOrWhiteSpace(item.Email) ? "Não informado" : item.Email)
                                    </td>
                                    <td class="text-end pe-4">
                                        <div class="d-inline-flex gap-1">
                                            <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary" title="Editar">
                                                <i class="bi bi-pencil-square"></i> Editar
                                            </a>
                                            <form asp-action="Delete" asp-route-id="@item.Id" method="post" class="d-inline" onsubmit="return confirm('Confirmar exclusão do cliente @item.Nome?');">
                                                @Html.AntiForgeryToken()
                                                <button type="submit" class="btn btn-sm btn-outline-danger" title="Excluir">
                                                    <i class="bi bi-trash"></i>
                                                </button>
                                            </form>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        (function () {
            var input = document.getElementById('filtroClientes');
            if (!input) return;
            input.addEventListener('input', function () {
                var termo = (input.value || '').toLowerCase().trim();
                document.querySelectorAll('#tabelaClientes .cliente-linha').forEach(function (tr) {
                    var texto = (tr.textContent || '').toLowerCase();
                    tr.style.display = (!termo || texto.indexOf(termo) !== -1) ? '' : 'none';
                });
            });
        })();
    </script>
}
