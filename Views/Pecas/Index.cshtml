@model IEnumerable<AssistenciaTech.Models.Peca>

@{
    ViewData["Title"] = "Estoque de Peças";
}

<div class="container-fluid mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>Gestão de Estoque (Peças)</h2>
        <a asp-action="Create" class="btn btn-primary"><i class="bi bi-plus-circle"></i> Nova Peça</a>
    </div>

    <div class="card shadow mb-4">
        <div class="card-header py-3">
            <h6 class="m-0 font-weight-bold text-primary">Peças Cadastradas</h6>
        </div>
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-bordered table-hover align-middle" width="100%" cellspacing="0">
                    <thead class="table-dark">
                        <tr>
                            <th>ID</th>
                            <th>Nome da Peça</th>
                            <th>Estoque Atual</th>
                            <th>Valor Unit. Venda</th>
                            <th class="text-center">Ações</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td class="fw-bold">#@item.Id</td>
                                <td>@item.Nome</td>
                                <td>
                                    <span class="badge @(item.QuantidadeEstoque > 0 ? "bg-success" : "bg-danger") fs-6">
                                        @item.QuantidadeEstoque un.
                                    </span>
                                </td>
                                <td>@item.ValorUnitario.ToString("C")</td>
                                <td class="text-center">
                                    <div class="d-inline-flex">
                                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary me-2" title="Editar">
                                            <i class="bi bi-pencil-square"></i> Editar
                                        </a>
                                        <form asp-action="Delete" asp-route-id="@item.Id" method="post" onsubmit="return confirm('Excluir peça @item.Nome?');">
                                            <button type="submit" class="btn btn-sm btn-outline-danger" title="Excluir">
                                                <i class="bi bi-trash"></i> Excluir
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
