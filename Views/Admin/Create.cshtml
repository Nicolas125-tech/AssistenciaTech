@model AssistenciaTech.Models.OrdemServico

@{
    ViewData["Title"] = "Nova Ordem de Serviço";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow">
                <div class="card-header bg-primary text-white">
                    <h5 class="mb-0">Dar Entrada em Equipamento</h5>
                </div>
                <div class="card-body">
                    <form asp-action="Create">
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                        <div class="row mb-3">
                            <div class="col-md-12 form-group">
                                <div class="d-flex justify-content-between">
                                    <label asp-for="ClienteId" class="form-label fw-bold">Cliente</label>
                                    <a asp-controller="Clientes" asp-action="Create" class="text-decoration-none"><i class="bi bi-person-plus"></i> Novo Cliente</a>
                                </div>
                                <select asp-for="ClienteId" class="form-select" asp-items="ViewBag.Clientes" required>
                                    <option value="">-- Selecione o Cliente --</option>
                                </select>
                                <span asp-validation-for="ClienteId" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="row mb-3">
                            <div class="col-md-12 form-group">
                                <label asp-for="Equipamento" class="form-label fw-bold">Equipamento</label>
                                <input asp-for="Equipamento" class="form-control" placeholder="Ex: Notebook Dell Inspiron 15" required />
                                <span asp-validation-for="Equipamento" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="row mb-3">
                            <div class="col-md-12 form-group">
                                <label asp-for="ProblemaRelatado" class="form-label fw-bold">Problema Relatado</label>
                                <textarea asp-for="ProblemaRelatado" class="form-control" rows="3" placeholder="Descreva o defeito informado pelo cliente" required></textarea>
                                <span asp-validation-for="ProblemaRelatado" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="row mb-3">
                            <div class="col-md-12 form-group">
                                <label asp-for="AvariasPreExistentes" class="form-label fw-bold">Avarias Pré-Existentes (Checklist Visual)</label>
                                <textarea asp-for="AvariasPreExistentes" class="form-control" rows="2" placeholder="Descreva arranhões, trincas, peças faltando, etc."></textarea>
                                <span asp-validation-for="AvariasPreExistentes" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="row mb-3">
                            <div class="col-md-4 form-group">
                                <label asp-for="CustoPecas" class="form-label fw-bold">Custo de Peças (R$)</label>
                                <input asp-for="CustoPecas" type="number" step="0.01" class="form-control custo-input" value="0.00" />
                                <span asp-validation-for="CustoPecas" class="text-danger"></span>
                            </div>
                            <div class="col-md-4 form-group">
                                <label asp-for="CustoMaoDeObra" class="form-label fw-bold">Mão de Obra (R$)</label>
                                <input asp-for="CustoMaoDeObra" type="number" step="0.01" class="form-control custo-input" value="0.00" />
                                <span asp-validation-for="CustoMaoDeObra" class="text-danger"></span>
                            </div>
                            <div class="col-md-4 form-group">
                                <label asp-for="DescontoAplicado" class="form-label fw-bold">Desconto (R$)</label>
                                <input asp-for="DescontoAplicado" type="number" step="0.01" class="form-control custo-input" value="0.00" />
                                <span asp-validation-for="DescontoAplicado" class="text-danger"></span>
                            </div>
                        </div>
                        
                        <div class="row mb-3">
                            <div class="col-md-12 text-end">
                                <h4 class="fw-bold">Total: <span id="valorTotalDisplay" class="text-success">R$ 0,00</span></h4>
                            </div>
                        </div>

                        <hr />
                        <div class="d-flex justify-content-between">
                            <a asp-action="Index" class="btn btn-secondary">Voltar ao Painel</a>
                            <button type="submit" class="btn btn-success"><i class="bi bi-save"></i> Salvar Ordem</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="~/Views/Shared/_ValidationScriptsPartial.cshtml" />
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const inputs = document.querySelectorAll('.custo-input');
            const totalDisplay = document.getElementById('valorTotalDisplay');

            function calcularTotal() {
                let pecas = parseFloat(document.getElementById('CustoPecas').value) || 0;
                let maoDeObra = parseFloat(document.getElementById('CustoMaoDeObra').value) || 0;
                let desconto = parseFloat(document.getElementById('DescontoAplicado').value) || 0;
                
                let total = (pecas + maoDeObra) - desconto;
                totalDisplay.innerText = total.toLocaleString('pt-BR', { style: 'currency', currency: 'BRL' });
            }

            inputs.forEach(input => {
                input.addEventListener('input', calcularTotal);
            });
            
            calcularTotal();
        });
    </script>
}
