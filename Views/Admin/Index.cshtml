@model AssistenciaTech.ViewModels.AdminDashboardViewModel

@{
    ViewData["Title"] = "Painel Administrativo - Ordens de Serviço";
    var kanbanColunas = new (string StatusKey, string Titulo, string BadgeClass, string IconClass)[]
    {
        (AssistenciaTech.Models.WorkflowStatus.Recebido, "Recebido", "bg-secondary", "bi-inbox"),
        (AssistenciaTech.Models.WorkflowStatus.EmAnalise, "Em Análise", "bg-warning text-dark", "bi-search"),
        (AssistenciaTech.Models.WorkflowStatus.AguardandoAprovacao, "Aguardando Aprovação", "bg-info text-dark", "bi-hourglass-split"),
        (AssistenciaTech.Models.WorkflowStatus.AguardandoPecas, "Aguardando Peças", "bg-danger", "bi-box-seam"),
        (AssistenciaTech.Models.WorkflowStatus.EmReparo, "Em Reparo", "bg-primary", "bi-tools"),
        (AssistenciaTech.Models.WorkflowStatus.Concluido, "Concluído", "bg-success", "bi-check2-circle"),
        (AssistenciaTech.Models.WorkflowStatus.Entregue, "Entregue", "bg-dark", "bi-bag-check")
    };
}

<div class="container-fluid mt-4">
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-2">
        <div>
            <h2 class="mb-0 fw-bold">Painel do Técnico</h2>
            <small class="text-muted">Gestão operacional em tempo real de Ordens de Serviço e SLA</small>
        </div>
        <div class="d-flex flex-wrap gap-2">
            <a asp-controller="Clientes" asp-action="Index" class="btn btn-secondary"><i class="bi bi-people"></i> Clientes</a>
            <a asp-action="Create" class="btn btn-primary"><i class="bi bi-plus-circle"></i> Nova Ordem de Serviço</a>
            <a asp-action="ExportarCsv" class="btn btn-success"><i class="bi bi-file-earmark-excel"></i> Exportar CSV</a>
        </div>
    </div>

    @if (Model.ErroBanco != null)
    {
        <div class="alert alert-danger shadow-sm border-0 rounded-4" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i> @Model.ErroBanco
        </div>
    }

    <div class="card shadow mb-4">
        <div class="card-body">
            <form asp-action="Index" method="get" class="row g-3 align-items-center">
                <div class="col-md-5 col-sm-12">
                    <div class="input-group">
                        <span class="input-group-text bg-dark border-secondary text-muted"><i class="bi bi-search"></i></span>
                        <input type="text" name="searchString" class="form-control" placeholder="Buscar por Cliente, Equipamento, NS ou Nº OS..." value="@Model.SearchString" />
                    </div>
                </div>
                <div class="col-md-4 col-sm-8">
                    <select name="statusFilter" class="form-select">
                        <option value="">Todos os Status do Fluxo</option>
                        <option value="@AssistenciaTech.Models.WorkflowStatus.Recebido" selected="@(Model.StatusFilter == AssistenciaTech.Models.WorkflowStatus.Recebido)">Recebido</option>
                        <option value="@AssistenciaTech.Models.WorkflowStatus.EmAnalise" selected="@(Model.StatusFilter == AssistenciaTech.Models.WorkflowStatus.EmAnalise)">Em Análise</option>
                        <option value="@AssistenciaTech.Models.WorkflowStatus.AguardandoAprovacao" selected="@(Model.StatusFilter == AssistenciaTech.Models.WorkflowStatus.AguardandoAprovacao)">Aguardando Aprovação do Orçamento</option>
                        <option value="@AssistenciaTech.Models.WorkflowStatus.AguardandoPecas" selected="@(Model.StatusFilter == AssistenciaTech.Models.WorkflowStatus.AguardandoPecas)">Aguardando Peças</option>
                        <option value="@AssistenciaTech.Models.WorkflowStatus.EmReparo" selected="@(Model.StatusFilter == AssistenciaTech.Models.WorkflowStatus.EmReparo)">Em Reparo</option>
                        <option value="@AssistenciaTech.Models.WorkflowStatus.Concluido" selected="@(Model.StatusFilter == AssistenciaTech.Models.WorkflowStatus.Concluido)">Concluído</option>
                        <option value="@AssistenciaTech.Models.WorkflowStatus.Entregue" selected="@(Model.StatusFilter == AssistenciaTech.Models.WorkflowStatus.Entregue)">Entregue ao Cliente</option>
                    </select>
                </div>
                <div class="col-md-3 col-sm-4 d-flex gap-2">
                    <button type="submit" class="btn btn-primary flex-grow-1"><i class="bi bi-funnel"></i> Filtrar</button>
                    @if (!string.IsNullOrEmpty(Model.SearchString) || !string.IsNullOrEmpty(Model.StatusFilter))
                    {
                        <a asp-action="Index" class="btn btn-outline-secondary" title="Limpar Filtros"><i class="bi bi-x-lg"></i></a>
                    }
                </div>
            </form>
        </div>
    </div>

    <!-- Dashboard Resumo -->
    <div class="row mb-4">
        <div class="col-md-4 mb-3 mb-md-0">
            <div class="card bg-primary text-white shadow h-100">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div class="me-3">
                            <div class="text-white-50 small text-uppercase fw-semibold">Total de OS Abertas</div>
                            <div class="fs-3 fw-bold">@Model.DashboardData.TotalAbertas</div>
                        </div>
                        <i class="bi bi-tools fs-1 text-info opacity-75"></i>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-4 mb-3 mb-md-0">
            <div class="card bg-success text-white shadow h-100">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div class="me-3">
                            <div class="text-white-50 small text-uppercase fw-semibold">Equipamentos Prontos</div>
                            <div class="fs-3 fw-bold text-success">@Model.DashboardData.EquipamentosProntos</div>
                        </div>
                        <i class="bi bi-check-circle fs-1 text-success opacity-75"></i>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card bg-dark text-white shadow h-100">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div class="me-3">
                            <div class="text-white-50 small text-uppercase fw-semibold">Faturamento Previsto</div>
                            <div class="fs-3 fw-bold text-info">@(((decimal)Model.DashboardData.FaturamentoPrevisto).ToString("C"))</div>
                        </div>
                        <i class="bi bi-cash-stack fs-1 text-info opacity-75"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="row mb-4">
        <div class="col-md-12">
            <div class="card shadow">
                <div class="card-header py-3 d-flex justify-content-between align-items-center">
                    <h6 class="m-0 fw-bold text-info"><i class="bi bi-bar-chart-line me-2"></i>Distribuição de OS por Status</h6>
                    <span class="badge bg-light text-dark">Total listado: @Model.DashboardData.TotalOrdens</span>
                </div>
                <div class="card-body">
                    <canvas id="statusChart" style="max-height: 260px;"></canvas>
                </div>
            </div>
        </div>
    </div>

    <!-- Alertas de Estoque Mínimo -->
    @if (Model.DashboardData.AlertasEstoque != null && ((IEnumerable<AssistenciaTech.Models.Peca>)Model.DashboardData.AlertasEstoque).Any())
    {
        <div class="row mb-4">
            <div class="col-md-12">
                <div class="card shadow border-danger">
                    <div class="card-header py-3 bg-danger text-white">
                        <h6 class="m-0 fw-bold"><i class="bi bi-exclamation-triangle-fill me-2"></i>Alertas de Estoque Mínimo</h6>
                    </div>
                    <div class="card-body p-0">
                        <div class="table-responsive">
                            <table class="table table-hover align-middle mb-0">
                                <thead class="table-light">
                                    <tr>
                                        <th>Peça</th>
                                        <th class="text-center">Estoque Atual</th>
                                        <th class="text-center">Mínimo</th>
                                        <th class="text-center">Situação</th>
                                        <th class="text-end">Ação</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var peca in (IEnumerable<AssistenciaTech.Models.Peca>)Model.DashboardData.AlertasEstoque)
                                    {
                                        <tr>
                                            <td class="fw-bold">@peca.Nome</td>
                                            <td class="text-center">
                                                <span class="badge @(peca.QuantidadeEstoque == 0 ? "bg-danger" : "bg-warning text-dark") fs-6">@peca.QuantidadeEstoque un.</span>
                                            </td>
                                            <td class="text-center">@peca.QuantidadeMinima un.</td>
                                            <td class="text-center">
                                                @if (peca.QuantidadeEstoque == 0)
                                                {
                                                    <span class="badge bg-danger"><i class="bi bi-x-circle"></i> Sem Estoque</span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-warning text-dark"><i class="bi bi-exclamation-triangle"></i> Estoque Baixo</span>
                                                }
                                            </td>
                                            <td class="text-end">
                                                <a asp-controller="Pecas" asp-action="Edit" asp-route-id="@peca.Id" class="btn btn-sm btn-outline-primary">
                                                    <i class="bi bi-pencil-square"></i> Repor
                                                </a>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }

    <!-- Seção Híbrida: Tabela Gerencial + Quadro Kanban -->
    <div class="card shadow mb-4">
        <div class="card-header py-3 d-flex flex-wrap justify-content-between align-items-center gap-2">
            <h6 class="m-0 fw-bold text-info"><i class="bi bi-kanban me-2"></i>Ordens de Serviço Recentes</h6>
            <div class="view-switcher-group" role="group" aria-label="Alternar modo de visualização">
                <button type="button" id="btnViewTable" class="btn view-switcher-btn active" onclick="switchDashboardView('table')">
                    <i class="bi bi-table me-1"></i> Tabela
                </button>
                <button type="button" id="btnViewKanban" class="btn view-switcher-btn" onclick="switchDashboardView('kanban')">
                    <i class="bi bi-kanban me-1"></i> Quadro Kanban
                </button>
            </div>
        </div>
        <div class="card-body">
            <!-- MODO 1: TABELA DE ALTA DENSIDADE -->
            <div id="osTableView">
                <div class="table-responsive">
                    <table class="table table-bordered table-hover align-middle" width="100%" cellspacing="0">
                        <thead class="table-dark">
                            <tr>
                                <th>Nº OS</th>
                                <th>Cliente</th>
                                <th>Equipamento</th>
                                <th>Entrada</th>
                                <th>Status</th>
                                <th>Orçamento</th>
                                <th class="text-center">Ações</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (!Model.DashboardData.Ordens.Any())
                            {
                                <tr>
                                    <td colspan="7" class="text-center py-5 text-muted">
                                        <i class="bi bi-inbox fs-1 d-block mb-3"></i>
                                        <h5>Nenhuma Ordem de Serviço encontrada</h5>
                                        <p class="mb-3">As OS cadastradas ou filtradas aparecerão aqui.</p>
                                        <a asp-action="Create" class="btn btn-sm btn-primary"><i class="bi bi-plus-circle me-1"></i> Cadastrar Primeira OS</a>
                                    </td>
                                </tr>
                            }
                            else
                            {
                                @foreach (var item in Model.DashboardData.Ordens)
                                {
                                    string badgeClass = item.Status switch
                                    {
                                        AssistenciaTech.Models.WorkflowStatus.Recebido => "bg-secondary",
                                        AssistenciaTech.Models.WorkflowStatus.EmAnalise => "bg-warning text-dark",
                                        AssistenciaTech.Models.WorkflowStatus.AguardandoAprovacao => "bg-info text-dark",
                                        AssistenciaTech.Models.WorkflowStatus.AguardandoPecas => "bg-danger",
                                        AssistenciaTech.Models.WorkflowStatus.EmReparo => "bg-primary",
                                        AssistenciaTech.Models.WorkflowStatus.Concluido => "bg-success",
                                        AssistenciaTech.Models.WorkflowStatus.Entregue => "bg-dark",
                                        _ => "bg-secondary"
                                    };

                                    <tr>
                                        <td class="fw-bold">
                                            <span class="font-monospace-tech">#@item.Id</span>
                                            @if (item.AparelhoAbandonado)
                                            {
                                                <br /><span class="badge bg-danger mt-1" title="Mais de 90 dias sem retirada"><i class="bi bi-exclamation-triangle"></i> Abandonado</span>
                                            }
                                            @if (item.Prioridade == 2)
                                            {
                                                <br /><span class="badge bg-danger mt-1"><i class="bi bi-lightning-charge"></i> Urgente</span>
                                            }
                                            else if (item.Prioridade == 1)
                                            {
                                                <br /><span class="badge bg-warning text-dark mt-1"><i class="bi bi-lightning-charge"></i> Alta</span>
                                            }
                                            @if (!string.IsNullOrEmpty(item.AnotacoesInternas))
                                            {
                                                <br /><i class="bi bi-journal-text text-info mt-1" title="@item.AnotacoesInternas" data-bs-toggle="tooltip"></i>
                                            }
                                        </td>
                                        <td>@item.Cliente?.Nome</td>
                                        <td>
                                            <div class="fw-semibold">@item.Equipamento</div>
                                            @if (!string.IsNullOrEmpty(item.NumeroSerie))
                                            {
                                                <small class="font-monospace-tech">NS: @item.NumeroSerie</small>
                                            }
                                        </td>
                                        <td>@item.DataEntrada.ToString("dd/MM/yyyy")</td>
                                        <td>
                                            <span class="badge @badgeClass">@item.Status</span>
                                            @if (item.Status == AssistenciaTech.Models.WorkflowStatus.Entregue && item.DataVencimentoGarantia.HasValue)
                                            {
                                                <br />
                                                @if (item.GarantiaAtiva)
                                                {
                                                    <span class="badge bg-success mt-1" style="font-size: 0.65rem;">Garantia até @item.DataVencimentoGarantia.Value.ToString("dd/MM/yy")</span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-secondary mt-1" style="font-size: 0.65rem;">Garantia Expirada</span>
                                                }
                                            }
                                        </td>
                                        <td class="text-success fw-semibold">@item.ValorOrcamento.ToString("C")</td>
                                        <td class="text-center">
                                            <div class="d-inline-flex">
                                                <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary me-2" title="Editar">
                                                    <i class="bi bi-pencil-square"></i> Editar
                                                </a>
                                                <a href="https://wa.me/55@(item.Cliente?.Telefone != null ? new string(item.Cliente.Telefone.Where(char.IsDigit).ToArray()) : string.Empty)?text=Ol%C3%A1%2C%20gostaria%20de%20atualizar%20sobre%20a%20Ordem%20de%20Servi%C3%A7o%20%23@item.Id%20do%20equipamento%20@Uri.EscapeDataString(item.Equipamento)." class="btn btn-sm btn-success me-2" target="_blank" title="Enviar WhatsApp">
                                                    <i class="bi bi-whatsapp"></i> WhatsApp
                                                </a>
                                                <a asp-action="ImprimirOs" asp-route-id="@item.Id" class="btn btn-sm btn-secondary me-2" target="_blank" title="Imprimir Recibo">
                                                    <i class="bi bi-printer"></i> Imprimir
                                                </a>
                                                <form asp-action="Delete" asp-route-id="@item.Id" method="post" onsubmit="return confirm('Tem certeza que deseja excluir a OS #@item.Id?');">
                                                    <button type="submit" class="btn btn-sm btn-outline-danger" title="Excluir">
                                                        <i class="bi bi-trash"></i> Excluir
                                                    </button>
                                                </form>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>

            <!-- MODO 2: QUADRO KANBAN INTERATIVO -->
            <div id="osKanbanView" class="d-none">
                <div class="kanban-board">
                    @foreach (var col in kanbanColunas)
                    {
                        var ordensColuna = Model.DashboardData.Ordens
                            .Where(o => string.Equals(o.Status, col.StatusKey, StringComparison.OrdinalIgnoreCase)
                                     || (col.StatusKey == AssistenciaTech.Models.WorkflowStatus.AguardandoAprovacao && o.Status == "Aguardando Aprovação")
                                     || (col.StatusKey == AssistenciaTech.Models.WorkflowStatus.Entregue && o.Status == "Entregue"))
                            .ToList();

                        <div class="kanban-column">
                            <div class="kanban-column-header">
                                <span class="fw-bold small text-uppercase d-flex align-items-center gap-2">
                                    <i class="bi @col.IconClass text-info"></i> @col.Titulo
                                </span>
                                <span class="badge @col.BadgeClass">@ordensColuna.Count</span>
                            </div>
                            <div class="kanban-column-body">
                                @if (!ordensColuna.Any())
                                {
                                    <div class="kanban-empty">
                                        <i class="bi bi-dash-circle d-block mb-1"></i>
                                        Sem OS nesta etapa
                                    </div>
                                }
                                else
                                {
                                    @foreach (var card in ordensColuna)
                                    {
                                        var priorityClass = card.Prioridade == 2 ? "priority-urgent" : (card.Prioridade == 1 ? "priority-high" : "");
                                        <div class="kanban-card @priorityClass">
                                            <div class="d-flex justify-content-between align-items-start mb-2">
                                                <span class="font-monospace-tech fw-bold">#@card.Id</span>
                                                <div class="d-flex gap-1 flex-wrap justify-content-end">
                                                    @if (card.Prioridade == 2)
                                                    {
                                                        <span class="badge bg-danger"><i class="bi bi-lightning-charge"></i> Urgente</span>
                                                    }
                                                    else if (card.Prioridade == 1)
                                                    {
                                                        <span class="badge bg-warning text-dark"><i class="bi bi-lightning-charge"></i> Alta</span>
                                                    }
                                                    @if (card.AparelhoAbandonado)
                                                    {
                                                        <span class="badge bg-danger">Abandonado</span>
                                                    }
                                                </div>
                                            </div>
                                            <div class="fw-bold mb-1">@card.Equipamento</div>
                                            <div class="small text-muted mb-2">
                                                <i class="bi bi-person me-1"></i>@(card.Cliente?.Nome ?? "Cliente N/D")
                                            </div>
                                            @if (!string.IsNullOrEmpty(card.NumeroSerie))
                                            {
                                                <div class="small font-monospace-tech mb-2">NS: @card.NumeroSerie</div>
                                            }
                                            <div class="d-flex justify-content-between align-items-center pt-2 border-top border-secondary">
                                                <div>
                                                    <small class="text-muted d-block"><i class="bi bi-calendar3 me-1"></i>@card.DataEntrada.ToString("dd/MM/yy")</small>
                                                    <span class="text-success fw-bold small">@card.ValorOrcamento.ToString("C")</span>
                                                </div>
                                                <div class="d-flex gap-1">
                                                    <a asp-action="Edit" asp-route-id="@card.Id" class="btn btn-sm btn-outline-primary px-2 py-1" title="Abrir OS #@card.Id">
                                                        <i class="bi bi-pencil-square"></i>
                                                    </a>
                                                    <a asp-action="ImprimirOs" asp-route-id="@card.Id" target="_blank" class="btn btn-sm btn-secondary px-2 py-1" title="Imprimir PDF">
                                                        <i class="bi bi-printer"></i>
                                                    </a>
                                                </div>
                                            </div>
                                        </div>
                                    }
                                }
                            </div>
                        </div>
                    }
                </div>
            </div>

            @if (Model.DashboardData.TotalPages > 1)
            {
                <nav aria-label="Navegação de páginas de Ordens de Serviço" class="mt-3">
                    <ul class="pagination justify-content-end mb-0">
                        @for (int p = 1; p <= Model.DashboardData.TotalPages; p++)
                        {
                            <li class="page-item @(p == Model.DashboardData.CurrentPage ? "active" : "")">
                                <a class="page-link bg-dark border-secondary text-light"
                                   asp-action="Index"
                                   asp-route-page="@p"
                                   asp-route-searchString="@Model.SearchString"
                                   asp-route-statusFilter="@Model.StatusFilter">@p</a>
                            </li>
                        }
                    </ul>
                </nav>
            }
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        function switchDashboardView(mode) {
            var tableView = document.getElementById('osTableView');
            var kanbanView = document.getElementById('osKanbanView');
            var btnTable = document.getElementById('btnViewTable');
            var btnKanban = document.getElementById('btnViewKanban');

            if (mode === 'kanban') {
                tableView.classList.add('d-none');
                kanbanView.classList.remove('d-none');
                btnTable.classList.remove('active');
                btnKanban.classList.add('active');
            } else {
                kanbanView.classList.add('d-none');
                tableView.classList.remove('d-none');
                btnKanban.classList.remove('active');
                btnTable.classList.add('active');
            }

            try {
                localStorage.setItem('techos_dashboard_view', mode);
            } catch (e) { }
        }

        document.addEventListener("DOMContentLoaded", function () {
            try {
                var savedMode = localStorage.getItem('techos_dashboard_view');
                if (savedMode === 'kanban') {
                    switchDashboardView('kanban');
                }
            } catch (e) { }

            var ctx = document.getElementById('statusChart').getContext('2d');

            var chartLabels = @Json.Serialize(Model.DashboardData.ChartLabels);
            var chartData = @Json.Serialize(Model.DashboardData.ChartData);

            var myChart = new Chart(ctx, {
                type: 'bar',
                data: {
                    labels: chartLabels,
                    datasets: [{
                        label: 'Quantidade de OS',
                        data: chartData,
                        backgroundColor: [
                            'rgba(56, 189, 248, 0.25)',
                            'rgba(245, 158, 11, 0.25)',
                            'rgba(16, 185, 129, 0.25)',
                            'rgba(239, 68, 68, 0.25)',
                            'rgba(139, 92, 246, 0.25)',
                            'rgba(59, 130, 246, 0.25)'
                        ],
                        borderColor: [
                            'rgba(56, 189, 248, 1)',
                            'rgba(245, 158, 11, 1)',
                            'rgba(16, 185, 129, 1)',
                            'rgba(239, 68, 68, 1)',
                            'rgba(139, 92, 246, 1)',
                            'rgba(59, 130, 246, 1)'
                        ],
                        borderWidth: 1,
                        borderRadius: 6
                    }]
                },
                options: {
                    scales: {
                        y: {
                            beginAtZero: true
                        }
                    }
                }
            });
        });
    </script>
}
