@model IEnumerable<AssistenciaTech.Models.Faturamento>

@{
    ViewData["Title"] = "Faturamentos e PIX · TechOS";
    decimal totalFaturado = Model.Sum(f => f.ValorTotal);
    decimal totalPago = Model.Where(f => f.StatusPagamento == AssistenciaTech.Models.PagamentoStatus.Pago_Total).Sum(f => f.ValorTotal);
    decimal totalPendente = totalFaturado - totalPago;
}

<div class="container-fluid mt-4 px-lg-4">
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-2">
        <div>
            <div class="d-flex align-items-center gap-2 mb-1">
                <span class="workbench-eyebrow">
                    <i class="bi bi-cash-coin"></i>
                    <span>Controle Financeiro e Fiscal</span>
                </span>
                <span class="badge bg-secondary font-monospace">@Model.Count() fatura(s)</span>
            </div>
            <h1 class="h3 mb-0 fw-bold">Faturamentos, Tributação e PIX</h1>
        </div>
    </div>

    <!-- Telemetria Financeira -->
    <div class="telemetry-strip mb-4">
        <div class="telemetry-cell">
            <div class="telemetry-label">
                <span>Total faturado no período</span>
                <i class="bi bi-wallet2 text-primary"></i>
            </div>
            <div class="telemetry-value text-primary">@totalFaturado.ToString("C")</div>
            <div class="small text-muted mt-1">Soma de todas as faturas geradas no caixa</div>
        </div>
        <div class="telemetry-cell">
            <div class="telemetry-label">
                <span>Recebimentos confirmados</span>
                <i class="bi bi-check2-circle text-success"></i>
            </div>
            <div class="telemetry-value text-success">@totalPago.ToString("C")</div>
            <div class="small text-muted mt-1">Faturas liquidadas integralmente</div>
        </div>
        <div class="telemetry-cell">
            <div class="telemetry-label">
                <span>Valores a receber</span>
                <i class="bi bi-hourglass-split @(totalPendente > 0 ? "text-warning" : "text-muted")"></i>
            </div>
            <div class="telemetry-value @(totalPendente > 0 ? "text-warning" : "text-main")">@totalPendente.ToString("C")</div>
            <div class="small text-muted mt-1">Faturas pendentes ou com quitação parcial</div>
        </div>
    </div>

    <div class="card workbench-panel overflow-hidden">
        <div class="card-header d-flex justify-content-between align-items-center">
            <span class="fw-semibold"><i class="bi bi-receipt-cutoff text-primary me-2"></i>Faturas e Cobranças</span>
            <span class="font-monospace small text-muted">FLUXO DE CAIXA</span>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead>
                        <tr>
                            <th class="ps-4">Fatura</th>
                            <th>OS Vinculada</th>
                            <th>Valor Total</th>
                            <th>Tributos (NFS-e)</th>
                            <th>Vencimento</th>
                            <th class="text-center">Situação</th>
                            <th class="text-end pe-4">Ações</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!Model.Any())
                        {
                            <tr>
                                <td colspan="7" class="text-center py-5 text-muted">
                                    <i class="bi bi-cash-coin fs-2 d-block mb-2"></i>
                                    <div class="fw-semibold">Nenhuma fatura gerada</div>
                                    <p class="small mb-0">As cobranças de ordens de serviço concluídas aparecerão aqui.</p>
                                </td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td class="ps-4 font-monospace fw-semibold">#@item.Id</td>
                                    <td class="font-monospace">
                                        <a asp-controller="Admin" asp-action="Edit" asp-route-id="@item.OrdemServicoId" class="text-primary text-decoration-none fw-medium">
                                            OS #@item.OrdemServicoId
                                        </a>
                                    </td>
                                    <td class="font-monospace fw-semibold text-main">
                                        @item.ValorTotal.ToString("C")
                                    </td>
                                    <td>
                                        <div class="small font-monospace text-muted">
                                            <div>ISS: <span class="text-main">@item.ValorISS.ToString("C")</span></div>
                                            <div>ICMS: <span class="text-main">@item.ValorICMS.ToString("C")</span></div>
                                        </div>
                                    </td>
                                    <td class="font-monospace small text-muted">
                                        @item.DataVencimento.ToString("dd/MM/yyyy")
                                    </td>
                                    <td class="text-center">
                                        @if (item.StatusPagamento == AssistenciaTech.Models.PagamentoStatus.Pago_Total)
                                        {
                                            <span class="badge bg-success">Pago</span>
                                        }
                                        else if (item.StatusPagamento == AssistenciaTech.Models.PagamentoStatus.Pago_Parcial)
                                        {
                                            <span class="badge bg-warning">Parcial</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-danger">Pendente</span>
                                        }
                                    </td>
                                    <td class="text-end pe-4">
                                        <div class="d-inline-flex flex-wrap justify-content-end gap-1">
                                            <a href="/Faturamentos/GerarXmlNfse/@item.Id" class="btn btn-sm btn-outline-secondary" target="_blank" title="Baixar XML da Nota Fiscal">
                                                <i class="bi bi-filetype-xml"></i> XML
                                            </a>
                                            @if (item.StatusPagamento == AssistenciaTech.Models.PagamentoStatus.Pago_Total)
                                            {
                                                <a href="/Faturamentos/GerarReciboPagamento/@item.Id" class="btn btn-sm btn-outline-primary" target="_blank" title="Imprimir recibo de quitação">
                                                    <i class="bi bi-receipt"></i> Recibo
                                                </a>
                                            }
                                            else
                                            {
                                                @if (!string.IsNullOrWhiteSpace(item.QrCodePayload))
                                                {
                                                    <button type="button" class="btn btn-sm btn-outline-primary" onclick="navigator.clipboard.writeText('@item.QrCodePayload'); alert('Código PIX Copia e Cola copiado para a área de transferência!');" title="Copiar código PIX">
                                                        <i class="bi bi-qr-code"></i> PIX
                                                    </button>
                                                }
                                                <form asp-action="MarcarPago" asp-route-id="@item.Id" method="post" class="d-inline" onsubmit="return confirm('Confirmar quitação integral da fatura #@item.Id?');">
                                                    @Html.AntiForgeryToken()
                                                    <button type="submit" class="btn btn-sm btn-outline-success" title="Registrar recebimento total">
                                                        <i class="bi bi-check-circle"></i> Quitar
                                                    </button>
                                                </form>
                                            }
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
