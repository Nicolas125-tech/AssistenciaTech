@model AssistenciaTech.Models.Peca

@{
    ViewData["Title"] = "Nova Peça";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow-sm border-0 rounded-lg">
                <div class="card-header bg-primary text-white text-center py-3">
                    <h5 class="mb-0">Adicionar Nova Peça ao Estoque</h5>
                </div>
                <div class="card-body">
                    <form asp-action="Create">
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                        
                        <div class="row mb-3">
                            <div class="col-md-12 form-group">
                                <label asp-for="Nome" class="form-label fw-bold">Nome da Peça</label>
                                <input asp-for="Nome" class="form-control" placeholder="Ex: Tela iPhone 13, SSD 480GB Kingston" required />
                                <span asp-validation-for="Nome" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="row mb-3">
                            <div class="col-md-6 form-group">
                                <label asp-for="QuantidadeEstoque" class="form-label fw-bold">Qtd. Estoque</label>
                                <input asp-for="QuantidadeEstoque" class="form-control" type="number" min="0" required />
                                <span asp-validation-for="QuantidadeEstoque" class="text-danger"></span>
                            </div>
                            <div class="col-md-6 form-group">
                                <label asp-for="ValorUnitario" class="form-label fw-bold">Valor Unitário Venda</label>
                                <input asp-for="ValorUnitario" class="form-control" type="number" step="0.01" min="0" required />
                                <span asp-validation-for="ValorUnitario" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="d-flex justify-content-end mt-4">
                            <a asp-action="Index" class="btn btn-secondary me-2">Cancelar</a>
                            <button type="submit" class="btn btn-primary px-4"><i class="bi bi-save"></i> Salvar</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
