@{
    ViewData["Title"] = "Autenticação de Operador";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6 col-lg-4">
            <div class="mb-3 d-flex justify-content-between align-items-center">
                <span class="workbench-eyebrow">
                    <i class="bi bi-shield-lock"></i>
                    <span>Acesso Restrito</span>
                </span>
                <span class="font-monospace small text-muted">OPERADOR</span>
            </div>

            <div class="card workbench-panel">
                <div class="card-header">
                    <h1 class="h5 mb-0 fw-semibold">Credenciais de Bancada</h1>
                </div>
                <div class="card-body p-4">
                    @if (!ViewData.ModelState.IsValid)
                    {
                        <div class="alert alert-danger py-2 small">
                            @Html.ValidationSummary(false, "", new { @class = "mb-0" })
                        </div>
                    }

                    <form asp-controller="Account" asp-action="Login" method="post">
                        <input type="hidden" name="returnUrl" value="@ViewBag.ReturnUrl" />

                        <div class="mb-3">
                            <label for="username" class="form-label">Operador / Usuário</label>
                            <div class="input-group">
                                <span class="input-group-text"><i class="bi bi-person"></i></span>
                                <input type="text" class="form-control font-monospace" id="username" name="username" required autofocus autocomplete="username">
                            </div>
                        </div>

                        <div class="mb-4">
                            <label for="password" class="form-label">Senha</label>
                            <div class="input-group">
                                <span class="input-group-text"><i class="bi bi-key"></i></span>
                                <input type="password" class="form-control" id="password" name="password" required autocomplete="current-password">
                            </div>
                        </div>

                        <div class="d-grid">
                            <button type="submit" class="btn btn-primary py-2">
                                <i class="bi bi-box-arrow-in-right me-1"></i> Acessar Painel Técnico
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
