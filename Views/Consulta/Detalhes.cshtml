@model AssistenciaTech.Models.OrdemServico

@{
    ViewData["Title"] = "Detalhes da Ordem de Serviço";

    // Define a cor do badge de status
    string statusBadgeClass = Model.Status switch
    {
        AssistenciaTech.Models.WorkflowStatus.Recebido => "bg-secondary",
        AssistenciaTech.Models.WorkflowStatus.EmAnalise => "bg-warning text-dark",
        AssistenciaTech.Models.WorkflowStatus.AguardandoAprovacao => "bg-info text-dark",
        AssistenciaTech.Models.WorkflowStatus.AguardandoPecas => "bg-danger",
        AssistenciaTech.Models.WorkflowStatus.EmReparo => "bg-primary",
        AssistenciaTech.Models.WorkflowStatus.Concluido => "bg-success",
        AssistenciaTech.Models.WorkflowStatus.Entregue => "bg-dark",
        _ => "bg-secondary"
    };
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow-sm border-0 rounded-lg">
                <div class="card-header bg-dark text-white text-center py-3">
                    <h4 class="mb-0">Detalhes da Ordem de Serviço #@Model.Id</h4>
                </div>
                <div class="card-body p-4">
                    
                    <div class="row mb-3">
                        <div class="col-sm-4 fw-bold">Status Atual:</div>
                        <div class="col-sm-8">
                            <span class="badge @statusBadgeClass fs-6">@Model.Status</span>
                        </div>
                    </div>

                    <hr />

                    <div class="row mb-3">
                        <div class="col-sm-4 fw-bold">Cliente:</div>
                        <div class="col-sm-8">@Model.Cliente?.Nome</div>
                    </div>

                    <div class="row mb-3">
                        <div class="col-sm-4 fw-bold">Equipamento:</div>
                        <div class="col-sm-8">@Model.Equipamento</div>
                    </div>

                    <div class="row mb-3">
                        <div class="col-sm-4 fw-bold">Problema Relatado:</div>
                        <div class="col-sm-8">@Model.ProblemaRelatado</div>
                    </div>

                    <div class="row mb-3">
                        <div class="col-sm-4 fw-bold">Data de Entrada:</div>
                        <div class="col-sm-8">@Model.DataEntrada.ToString("dd/MM/yyyy HH:mm")</div>
                    </div>

                    @if (Model.DataConclusao.HasValue)
                    {
                        <div class="row mb-3">
                            <div class="col-sm-4 fw-bold">Data de Conclusão:</div>
                            <div class="col-sm-8">@Model.DataConclusao.Value.ToString("dd/MM/yyyy HH:mm")</div>
                        </div>
                    }

                    @if (Model.DataEntregaCliente.HasValue)
                    {
                        <div class="row mb-3">
                            <div class="col-sm-4 fw-bold">Data de Retirada:</div>
                            <div class="col-sm-8">@Model.DataEntregaCliente.Value.ToString("dd/MM/yyyy HH:mm")</div>
                        </div>
                    }

                    @if (Model.ValorOrcamento > 0)
                    {
                        <div class="row mb-3">
                            <div class="col-sm-4 fw-bold">Valor do Orçamento:</div>
                            <div class="col-sm-8 text-success fw-bold">@Model.ValorOrcamento.ToString("C")</div>
                        </div>
                    }

                </div>
                <div class="card-footer text-center py-3">
                    <a href="~/Consulta/Index" class="btn btn-outline-primary">Fazer nova consulta</a>
                </div>
            </div>
        </div>
    </div>
</div>
