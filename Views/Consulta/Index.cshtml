@{
    ViewData["Title"] = "Consulta de Ordem de Serviço";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow-lg border-0 rounded-lg mt-5">
                <div class="card-header bg-primary text-white text-center">
                    <h3 class="font-weight-light my-4">Área do Cliente</h3>
                    <p class="mb-0">Consulte o status do seu equipamento</p>
                </div>
                <div class="card-body">
                    
                    @* Exibe mensagem de erro caso a OS não seja encontrada *@
                    @if (ViewBag.Erro != null)
                    {
                        <div class="alert alert-danger text-center" role="alert">
                            @ViewBag.Erro
                        </div>
                    }

                    <form asp-controller="Consulta" asp-action="Status" method="post">
                        <div class="form-floating mb-3">
                            <input type="number" class="form-control" id="numeroOS" name="numeroOS" placeholder="Ex: 12345" required>
                            <label for="numeroOS">Número da Ordem de Serviço (OS)</label>
                        </div>
                        
                        <div class="form-floating mb-3">
                            <input type="text" class="form-control" id="cpf" name="cpf" placeholder="000.000.000-00" required aria-describedby="cpfHelp">
                            <label for="cpf">CPF do Titular</label>
                            <div class="form-text" id="cpfHelp">Digite apenas os números ou com pontuação.</div>
                        </div>

                        <div class="d-flex align-items-center justify-content-between mt-4 mb-0">
                            <button type="submit" class="btn btn-primary w-100 py-2">Consultar Status <i class="bi bi-search"></i></button>
                        </div>
                    </form>

                    <div class="text-center mt-3 mb-2">
                        <span class="text-muted small">OU</span>
                    </div>

                    <a href="~/Account/LoginWithGoogle" class="btn btn-google w-100 py-2 shadow-sm">
                        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 48 48" class="me-2">
                            <path fill="#EA4335" d="M24 9.5c3.54 0 6.71 1.22 9.21 3.6l6.85-6.85C35.9 2.38 30.47 0 24 0 14.62 0 6.51 5.38 2.56 13.22l7.98 6.19C12.43 13.72 17.74 9.5 24 9.5z"/>
                            <path fill="#4285F4" d="M46.5 24c0-1.61-.15-3.16-.42-4.69H24v9.09h12.75c-.53 2.87-2.14 5.31-4.57 6.96l7.15 5.54C39.49 36.31 46.5 30.93 46.5 24z"/>
                            <path fill="#FBBC05" d="M10.54 28.59c-.48-1.45-.76-2.99-.76-4.59s.27-3.14.76-4.59l-7.98-6.19C.92 16.46 0 20.12 0 24c0 3.88.92 7.54 2.56 10.78l7.98-6.19z"/>
                            <path fill="#34A853" d="M24 48c6.48 0 11.93-2.13 15.89-5.81l-7.15-5.54c-1.99 1.33-4.51 2.1-8.74 2.1-6.26 0-11.57-4.22-13.46-9.91l-7.98 6.19C6.51 42.62 14.62 48 24 48z"/>
                        </svg>
                        Entrar com o Google
                    </a>
                </div>
                <div class="card-footer text-center py-3">
                    <div class="small"><a href="~/Home/Index">Voltar para a Página Inicial</a></div>
                </div>
            </div>
        </div>
    </div>
</div>
