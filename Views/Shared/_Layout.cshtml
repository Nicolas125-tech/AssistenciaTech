<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - TechOS</title>
    <link rel="icon" type="image/svg+xml" href="/images/favicon.svg" />
    <!-- Google Fonts: Inter & Fira Code -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Fira+Code:wght@400;500;700&family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">

    <!-- Bootstrap 5 CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />
    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <!-- Custom TechOS CSS -->
    <link rel="stylesheet" href="/css/site.css" />
    
    <style>
        body {
            /* Compensa a navbar fixa */
            padding-top: 76px; 
            display: flex;
            flex-direction: column;
            min-height: 100vh;
        }
        main {
            flex: 1;
        }
    </style>
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-lg navbar-dark bg-dark fixed-top shadow-sm py-3">
            <div class="container">
                <a class="navbar-brand d-flex align-items-center" asp-controller="Home" asp-action="Index">
                    <img src="/images/logo.svg" alt="TechOS Logo" height="36" />
                </a>
                <button class="navbar-toggler border-0" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav" aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="navbarNav">
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0 fs-5">
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Home" asp-action="Index">Início</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Home" asp-action="Servicos">Serviços</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-info" asp-controller="Consulta" asp-action="Index">Consulta de OS</a>
                        </li>
                    </ul>
                    
                    <ul class="navbar-nav ms-auto align-items-center">
                        @* Exibição condicional baseada na Autenticação (Cookie Auth) *@
                        @if (User.Identity != null && User.Identity.IsAuthenticated)
                        {
                            <li class="nav-item me-2">
                                <a class="nav-link text-success fw-bold bg-dark border border-success rounded px-3" asp-controller="Pecas" asp-action="Index">
                                    <i class="bi bi-box-seam"></i> Estoque
                                </a>
                            </li>
                            <li class="nav-item me-2">
                                <a class="nav-link text-info fw-bold bg-dark border border-info rounded px-3" asp-controller="Clientes" asp-action="Index">
                                    <i class="bi bi-people"></i> Clientes
                                </a>
                            </li>
                            <li class="nav-item dropdown me-3">
                                <a class="nav-link dropdown-toggle text-warning fw-bold bg-dark border border-warning rounded px-3" href="#" id="navbarDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                    <i class="bi bi-speedometer2"></i> Painel Admin
                                </a>
                                <ul class="dropdown-menu dropdown-menu-dark" aria-labelledby="navbarDropdown">
                                    <li><a class="dropdown-item" asp-controller="Admin" asp-action="Index">Geral (OS)</a></li>
                                    <li><hr class="dropdown-divider"></li>
                                    <li><a class="dropdown-item" asp-controller="Tecnicos" asp-action="Index"><i class="bi bi-person-badge"></i> Técnicos & Comissões</a></li>
                                    <li><a class="dropdown-item" asp-controller="EquipamentoBackup" asp-action="Index"><i class="bi bi-laptop"></i> Equipamentos de Backup</a></li>
                                    <li><a class="dropdown-item" asp-controller="Faturamentos" asp-action="Index"><i class="bi bi-cash-coin"></i> Faturamentos & PIX</a></li>
                                </ul>
                            </li>
                            <li class="nav-item">
                                <form asp-controller="Account" asp-action="Logout" method="post" class="m-0 p-0">
                                    <button type="submit" class="btn btn-danger btn-sm px-3 fw-bold shadow-sm">
                                        <i class="bi bi-box-arrow-right"></i> Sair
                                    </button>
                                </form>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item">
                                <a class="nav-link border border-secondary rounded px-3" asp-controller="Account" asp-action="Login">
                                    <i class="bi bi-person-badge"></i> Acesso Restrito
                                </a>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <main role="main">
        @RenderBody()
    </main>

    <footer class="bg-dark text-white-50 py-4 mt-auto border-top border-secondary">
        <div class="container text-center">
            <div class="mb-3 fs-4">
                <a href="https://wa.me/5543984445767" target="_blank" class="text-white-50 text-decoration-none me-3 transition-hover" title="Fale pelo WhatsApp">
                    <i class="bi bi-whatsapp text-success"></i> (43) 98444-5767
                </a>
                <a href="https://instagram.com/_nicolas_mb" target="_blank" class="text-white-50 text-decoration-none transition-hover" title="Siga no Instagram">
                    <i class="bi bi-instagram text-danger"></i> @@_nicolas_mb
                </a>
            </div>
            <p class="mb-0">&copy; @DateTime.Now.Year - TechOS. Todos os direitos reservados.</p>
            <small>Desenvolvido com C# e .NET 8</small>
        </div>
    </footer>

    <!-- Bootstrap 5 JS Bundle (with Popper) -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
