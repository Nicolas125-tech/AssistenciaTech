@model IEnumerable<AssistenciaTech.Models.OrdemServico>

@{
    ViewData["Title"] = "Painel Administrativo - Ordens de Serviço";
}

<div class="container-fluid mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>Painel do Técnico</h2>
        <div>
            <a asp-controller="Clientes" asp-action="Index" class="btn btn-secondary me-2"><i class="bi bi-people"></i> Clientes</a>
            <a asp-action="Create" class="btn btn-primary"><i class="bi bi-plus-circle"></i> Nova Ordem de Serviço</a>
            <a asp-action="ExportarCsv" class="btn btn-success"><i class="bi bi-file-earmark-excel"></i> Exportar CSV</a>
        </div>
    </div>

    @if (ViewBag.ErroBanco != null)
    {
        <div class="alert alert-danger shadow-sm border-0 rounded-4" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i> @ViewBag.ErroBanco
        </div>
    }

    <div class="card shadow mb-4">
        <div class="card-body">
            <form asp-action="Index" method="get" class="row g-3 align-items-center">
                <div class="col-auto">
                    <input type="text" name="searchString" class="form-control" placeholder="Buscar por Cliente, Equipamento ou Nº OS" value="@ViewBag.SearchString" />
                </div>
                <div class="col-auto">
                    <select name="statusFilter" class="form-select">
                        <option value="">Todos os Status</option>
                        <option value="Recebido" selected="@(ViewBag.StatusFilter == "Recebido")">Recebido</option>
                        <option value="Em Análise" selected="@(ViewBag.StatusFilter == "Em Análise")">Em Análise</option>
                        <option value="Aguardando Aprovação" selected="@(ViewBag.StatusFilter == "Aguardando Aprovação")">Aguardando Aprovação</option>
                        <option value="Aguardando Peças" selected="@(ViewBag.StatusFilter == "Aguardando Peças")">Aguardando Peças</option>
                        <option value="Em Reparo" selected="@(ViewBag.StatusFilter == "Em Reparo")">Em Reparo</option>
                        <option value="Concluído" selected="@(ViewBag.StatusFilter == "Concluído")">Concluído</option>
                        <option value="Entregue" selected="@(ViewBag.StatusFilter == "Entregue")">Entregue</option>
                        <option value="Cancelado" selected="@(ViewBag.StatusFilter == "Cancelado")">Cancelado</option>
                    </select>
                </div>
                <div class="col-auto">
                    <button type="submit" class="btn btn-primary"><i class="bi bi-search"></i> Filtrar</button>
                </div>
            </form>
        </div>
    </div>

    <div class="row mb-4">
        <div class="col-md-12">
            <div class="card shadow">
                <div class="card-header py-3">
                    <h6 class="m-0 font-weight-bold text-primary">OS por Status</h6>
                </div>
                <div class="card-body">
                    <canvas id="statusChart" style="max-height: 300px;"></canvas>
                </div>
            </div>
        </div>
    </div>
    <!-- Dashboard Resumo -->
    <div class="row mb-4">
        <div class="col-md-4">
            <div class="card bg-primary text-white shadow h-100">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div class="me-3">
                            <div class="text-white-50 small">Total de OS Abertas</div>
                            <div class="fs-4 fw-bold">@ViewBag.TotalAbertas</div>
                        </div>
                        <i class="bi bi-tools fs-1 text-white-50"></i>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card bg-success text-white shadow h-100">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div class="me-3">
                            <div class="text-white-50 small">Equipamentos Prontos</div>
                            <div class="fs-4 fw-bold">@ViewBag.EquipamentosProntos</div>
                        </div>
                        <i class="bi bi-check-circle fs-1 text-white-50"></i>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card bg-dark text-white shadow h-100">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div class="me-3">
                            <div class="text-white-50 small">Faturamento Previsto</div>
                            <div class="fs-4 fw-bold">@(((decimal)ViewBag.FaturamentoPrevisto).ToString("C"))</div>
                        </div>
                        <i class="bi bi-cash-stack fs-1 text-white-50"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Tabela Gerencial -->
    <div class="card shadow mb-4">
        <div class="card-header py-3">
            <h6 class="m-0 font-weight-bold text-primary">Ordens de Serviço Recentes</h6>
        </div>
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-bordered table-hover align-middle" width="100%" cellspacing="0">
                    <thead class="table-dark">
                        <tr>
                            <th>Nº OS</th>
                            <th>Cliente</th>
                            <th>Equipamento</th>
                            <th>Entrada</th>
                            <th>Status</th>
                            <th>Orçamento</th>
                            <th class="text-center">Ações</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            string badgeClass = item.Status switch
                            {
                                AssistenciaTech.Models.WorkflowStatus.Recebido => "bg-secondary",
                                AssistenciaTech.Models.WorkflowStatus.EmAnalise => "bg-warning text-dark",
                                AssistenciaTech.Models.WorkflowStatus.AguardandoAprovacao => "bg-info text-dark",
                                AssistenciaTech.Models.WorkflowStatus.AguardandoPecas => "bg-danger",
                                AssistenciaTech.Models.WorkflowStatus.EmReparo => "bg-primary",
                                AssistenciaTech.Models.WorkflowStatus.Concluido => "bg-success",
                                AssistenciaTech.Models.WorkflowStatus.Entregue => "bg-dark",
                                _ => "bg-secondary"
                            };

                            <tr>
                                <td class="fw-bold">
                                    #@item.Id
                                    @if (item.AparelhoAbandonado)
                                    {
                                        <br /><span class="badge bg-danger mt-1" title="Mais de 90 dias sem retirada"><i class="bi bi-exclamation-triangle"></i> Abandonado</span>
                                    }
                                </td>
                                <td>@item.Cliente?.Nome</td>
                                <td>@item.Equipamento</td>
                                <td>@item.DataEntrada.ToString("dd/MM/yyyy")</td>
                                <td>
                                    <span class="badge @badgeClass">@item.Status</span>
                                    @if (item.Status == AssistenciaTech.Models.WorkflowStatus.Entregue && item.DataVencimentoGarantia.HasValue)
                                    {
                                        <br />
                                        @if (item.GarantiaAtiva)
                                        {
                                            <span class="badge bg-success mt-1" style="font-size: 0.65rem;">Garantia até @item.DataVencimentoGarantia.Value.ToString("dd/MM/yy")</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary mt-1" style="font-size: 0.65rem;">Garantia Expirada</span>
                                        }
                                    }
                                </td>
                                <td>@item.ValorOrcamento.ToString("C")</td>
                                <td class="text-center">
                                    <div class="d-inline-flex">
                                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary me-2" title="Editar">
                                            <i class="bi bi-pencil-square"></i> Editar
                                        </a>
                                        <a href="https://wa.me/55@{if (item.Cliente?.Telefone != null) @Html.Raw(new string(item.Cliente.Telefone.Where(char.IsDigit).ToArray()))}?text=Ol%C3%A1%2C%20gostaria%20de%20atualizar%20sobre%20a%20Ordem%20de%20Servi%C3%A7o%20%23@item.Id%20do%20equipamento%20@Uri.EscapeDataString(item.Equipamento)." class="btn btn-sm btn-success me-2" target="_blank" title="Enviar WhatsApp">
                                            <i class="bi bi-whatsapp"></i> WhatsApp
                                        </a>
                                        <a asp-action="ImprimirOs" asp-route-id="@item.Id" class="btn btn-sm btn-secondary me-2" target="_blank" title="Imprimir Recibo">
                                            <i class="bi bi-printer"></i> Imprimir
                                        </a>
                                        <form asp-action="Delete" asp-route-id="@item.Id" method="post" onsubmit="return confirm('Tem certeza que deseja excluir a OS #@item.Id?');">
                                            <button type="submit" class="btn btn-sm btn-outline-danger" title="Excluir">
                                                <i class="bi bi-trash"></i> Excluir
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            var ctx = document.getElementById('statusChart').getContext('2d');

            var chartLabels = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(ViewBag.ChartLabels));
            var chartData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(ViewBag.ChartData));

            var myChart = new Chart(ctx, {
                type: 'bar',
                data: {
                    labels: chartLabels,
                    datasets: [{
                        label: 'Quantidade de OS',
                        data: chartData,
                        backgroundColor: [
                            'rgba(255, 99, 132, 0.2)',
                            'rgba(54, 162, 235, 0.2)',
                            'rgba(255, 206, 86, 0.2)',
                            'rgba(75, 192, 192, 0.2)',
                            'rgba(153, 102, 255, 0.2)',
                            'rgba(255, 159, 64, 0.2)'
                        ],
                        borderColor: [
                            'rgba(255, 99, 132, 1)',
                            'rgba(54, 162, 235, 1)',
                            'rgba(255, 206, 86, 1)',
                            'rgba(75, 192, 192, 1)',
                            'rgba(153, 102, 255, 1)',
                            'rgba(255, 159, 64, 1)'
                        ],
                        borderWidth: 1
                    }]
                },
                options: {
                    scales: {
                        y: {
                            beginAtZero: true
                        }
                    }
                }
            });
        });
    </script>
}
