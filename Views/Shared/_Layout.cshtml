@{
    string telaPreferida = Context.Request.Cookies["TechOS_TelaInicial"] ?? "Bancada";
}
<!DOCTYPE html>
<html lang="pt-br" data-bs-theme="dark">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] · TechOS Laboratório Técnico</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Fira+Code:wght@400;500;600&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="d-flex flex-column min-vh-100">
    <header>
        <nav class="navbar navbar-expand-lg navbar-dark navbar-custom py-2 mb-0">
            <div class="container">
                <a class="navbar-brand brand-mark" asp-area="" asp-controller="Home" asp-action="Index" asp-route-tela="Bancada">
                    <i class="bi bi-cpu text-primary"></i>
                    <span>TechOS</span>
                    <span class="brand-tag">BANCADA v2</span>
                </a>
                <button class="navbar-toggler border-secondary" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Alternar navegação">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-lg-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1 gap-lg-1 ms-lg-3">
                        <li class="nav-item">
                            <a class="nav-link px-3" asp-area="" asp-controller="Home" asp-action="Index" asp-route-tela="Bancada">Bancada Inicial</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link px-3" asp-area="" asp-controller="Home" asp-action="Servicos">Tabela de Serviços</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link px-3" asp-area="" asp-controller="Consulta" asp-action="Index">Rastrear OS</a>
                        </li>
                    </ul>
                    <ul class="navbar-nav align-items-lg-center gap-2 mt-2 mt-lg-0">
                        <li class="nav-item dropdown">
                            <button class="btn btn-sm btn-outline-secondary dropdown-toggle d-inline-flex align-items-center gap-2" type="button" data-bs-toggle="dropdown" aria-expanded="false" title="Configurar qual tela abre por padrão no acesso inicial">
                                <i class="bi bi-sliders2 text-primary"></i>
                                <span> Início: <strong class="font-monospace">@(telaPreferida == "Consulta" ? "Consulta OS" : "Bancada")</strong></span>
                            </button>
                            <div class="dropdown-menu dropdown-menu-end p-3 workbench-panel" style="min-width: 270px;">
                                <div class="small fw-semibold mb-1">Tela inicial do cliente</div>
                                <p class="text-muted small mb-2">Escolha qual tela deve abrir automaticamente ao acessar a raiz do sistema.</p>
                                <form asp-controller="Home" asp-action="DefinirTelaInicial" method="post" class="d-grid gap-2">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="returnUrl" value="@Context.Request.Path" />
                                    <button type="submit" name="telaInicial" value="Bancada" class="btn btn-sm text-start @(telaPreferida != "Consulta" ? "btn-primary" : "btn-outline-secondary")">
                                        <i class="bi bi-grid-1x2 me-1"></i> Bancada Completa (Consulta + Catálogo)
                                    </button>
                                    <button type="submit" name="telaInicial" value="Consulta" class="btn btn-sm text-start @(telaPreferida == "Consulta" ? "btn-primary" : "btn-outline-secondary")">
                                        <i class="bi bi-search me-1"></i> Direto na Consulta de OS
                                    </button>
                                </form>
                            </div>
                        </li>
                        <li class="nav-item">
                            <a class="btn btn-sm btn-outline-secondary d-inline-flex align-items-center gap-1" asp-area="" asp-controller="Admin" asp-action="Index">
                                <i class="bi bi-terminal"></i>
                                <span>Operador / Admin</span>
                            </a>
                        </li>
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <div class="toast-container position-fixed top-0 end-0 p-3" style="z-index: 1090;">
        @if (TempData["MensagemSucesso"] != null)
        {
            <div class="toast align-items-center bg-success border-0 show" role="alert" aria-live="assertive" aria-atomic="true" data-bs-delay="4500">
                <div class="d-flex">
                    <div class="toast-body fw-medium">
                        <i class="bi bi-check2-circle me-2"></i>@TempData["MensagemSucesso"]
                    </div>
                    <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast" aria-label="Fechar"></button>
                </div>
            </div>
        }
        @if (TempData["MensagemErro"] != null)
        {
            <div class="toast align-items-center bg-danger border-0 show" role="alert" aria-live="assertive" aria-atomic="true" data-bs-delay="6000">
                <div class="d-flex">
                    <div class="toast-body fw-medium">
                        <i class="bi bi-exclamation-octagon me-2"></i>@TempData["MensagemErro"]
                    </div>
                    <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast" aria-label="Fechar"></button>
                </div>
            </div>
        }
    </div>

    <main role="main" class="flex-grow-1 pb-5">
        @RenderBody()
    </main>

    <footer class="footer py-3 mt-auto">
        <div class="container d-flex flex-column flex-sm-row justify-content-between align-items-center gap-2 small">
            <div>
                <span class="fw-semibold text-main">TechOS</span> · Laboratório de Manutenção de Hardware e Microeletrônica
            </div>
            <div class="font-monospace text-muted">
                Diagnóstico rastreável por Ordem de Serviço
            </div>
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            document.querySelectorAll('.toast.show').forEach(function (el) {
                var toast = new bootstrap.Toast(el);
                toast.show();
            });
        });
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
