@model IEnumerable<AssistenciaTech.Models.OrdemServico>

@{
    ViewData["Title"] = "Meus Equipamentos";
}

<div class="container mt-4 mt-lg-5">
    <div class="row justify-content-center">
        <div class="col-lg-10">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <div>
                    <h1 class="h3 fw-bold mb-1"><i class="bi bi-laptop text-primary me-1"></i> Meus Equipamentos</h1>
                    <p class="text-muted small mb-0">Histórico e andamento das ordens de serviço vinculadas ao seu cadastro</p>
                </div>
                <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                    <button type="submit" class="btn btn-outline-secondary btn-sm">
                        Encerrar sessão <i class="bi bi-box-arrow-right ms-1"></i>
                    </button>
                </form>
            </div>

            <div class="card workbench-panel overflow-hidden">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <span><i class="bi bi-list-task text-primary me-2"></i>Ordens de Serviço Registradas</span>
                    <span class="font-monospace small text-muted">@Model.Count() registro(s)</span>
                </div>
                <div class="card-body p-0">
                    @if (!Model.Any())
                    {
                        <div class="text-center py-5 my-2">
                            <i class="bi bi-clipboard-x fs-2 text-muted"></i>
                            <p class="mt-2 mb-0 text-muted">Nenhum equipamento em manutenção encontrado para este e-mail.</p>
                        </div>
                    }
                    else
                    {
                        <div class="table-responsive">
                            <table class="table table-hover align-middle mb-0">
                                <thead>
                                    <tr>
                                        <th class="ps-4">OS</th>
                                        <th>Equipamento</th>
                                        <th>Entrada</th>
                                        <th>Status</th>
                                        <th class="text-end pe-4">Ficha</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var os in Model)
                                    {
                                        string statusBadgeClass = os.Status switch
                                        {
                                            AssistenciaTech.Models.WorkflowStatus.Recebido => "bg-secondary",
                                            AssistenciaTech.Models.WorkflowStatus.EmAnalise => "bg-warning",
                                            AssistenciaTech.Models.WorkflowStatus.AguardandoAprovacao => "bg-info",
                                            AssistenciaTech.Models.WorkflowStatus.AguardandoPecas => "bg-danger",
                                            AssistenciaTech.Models.WorkflowStatus.EmReparo => "bg-primary",
                                            AssistenciaTech.Models.WorkflowStatus.Concluido => "bg-success",
                                            AssistenciaTech.Models.WorkflowStatus.Entregue => "bg-dark",
                                            _ => "bg-secondary"
                                        };

                                        <tr>
                                            <td class="ps-4 font-monospace fw-semibold">#@os.Id</td>
                                            <td>
                                                <span class="d-block fw-semibold">@os.Equipamento</span>
                                                @if (!string.IsNullOrEmpty(os.NumeroSerie))
                                                {
                                                    <small class="font-monospace text-muted">S/N: @os.NumeroSerie</small>
                                                }
                                            </td>
                                            <td class="font-monospace small">@os.DataEntrada.ToString("dd/MM/yyyy HH:mm")</td>
                                            <td>
                                                <span class="badge @statusBadgeClass">@os.Status</span>
                                            </td>
                                            <td class="text-end pe-4">
                                                <a asp-action="VisualizarOS" asp-route-id="@os.Id" class="btn btn-sm btn-outline-primary">
                                                    Ver laudo <i class="bi bi-chevron-right"></i>
                                                </a>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </div>
            </div>

            <div class="text-center mt-3">
                <small class="text-muted font-monospace">
                    Titular autenticado: <strong>@User.Identity?.Name</strong> (@User.FindFirst(System.Security.Claims.ClaimTypes.Email)?.Value)
                </small>
            </div>
        </div>
    </div>
</div>
