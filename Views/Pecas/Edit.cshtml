@model AssistenciaTech.DTOs.PecaEditDto

@{
    ViewData["Title"] = $"Editar Peça #{Model.Id} · TechOS";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="mb-3 d-flex justify-content-between align-items-center">
                <span class="workbench-eyebrow">
                    <i class="bi bi-pencil-square"></i>
                    <span>Atualização de Almoxarifado</span>
                </span>
                <a asp-action="Index" class="small text-muted text-decoration-none">
                    <i class="bi bi-arrow-left me-1"></i> Voltar ao estoque
                </a>
            </div>

            <div class="card workbench-panel">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <h1 class="h5 mb-0 fw-semibold">Editar Peça <span class="font-monospace text-primary">#@Model.Id</span></h1>
                    <span class="font-monospace small text-muted">OFICINA</span>
                </div>
                <div class="card-body p-4">
                    <form asp-action="Edit" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" asp-for="Id" />
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small mb-3"></div>

                        <div class="mb-3">
                            <label asp-for="Nome" class="form-label">Descrição da peça</label>
                            <input asp-for="Nome" class="form-control" required />
                            <span asp-validation-for="Nome" class="text-danger small"></span>
                        </div>

                        <div class="row g-3 mb-4">
                            <div class="col-md-4">
                                <label asp-for="QuantidadeEstoque" class="form-label">Quantidade em estoque</label>
                                <input asp-for="QuantidadeEstoque" class="form-control font-monospace" type="number" min="0" required />
                                <span asp-validation-for="QuantidadeEstoque" class="text-danger small"></span>
                            </div>
                            <div class="col-md-4">
                                <label asp-for="QuantidadeMinima" class="form-label">Estoque mínimo de alerta</label>
                                <input asp-for="QuantidadeMinima" class="form-control font-monospace" type="number" min="0" />
                                <span asp-validation-for="QuantidadeMinima" class="text-danger small"></span>
                            </div>
                            <div class="col-md-4">
                                <label asp-for="ValorUnitario" class="form-label">Preço unitário de venda (R$)</label>
                                <input asp-for="ValorUnitario" class="form-control font-monospace" type="number" step="0.01" min="0" required />
                                <span asp-validation-for="ValorUnitario" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="d-flex justify-content-between align-items-center pt-3 border-top border-secondary">
                            <a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
                            <button type="submit" class="btn btn-primary">
                                <i class="bi bi-check2 me-1"></i> Salvar Alterações
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
