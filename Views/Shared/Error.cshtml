@model AssistenciaTech.Models.ErrorViewModel
@{
    ViewData["Title"] = "Erro";
}

<div class="container py-5 mt-5 text-center">
    <h1 class="text-danger display-1"><i class="bi bi-exclamation-triangle-fill"></i></h1>
    <h2 class="text-danger fw-bold">Ocorreu um erro ao processar sua solicitação.</h2>
    <p class="lead">Desculpe pelo transtorno. Nossa equipe técnica já foi notificada.</p>

    @if (Model.ShowRequestId)
    {
        <p class="text-muted">
            <strong>Request ID:</strong> <code>@Model.RequestId</code>
        </p>
    }



    <a asp-controller="Home" asp-action="Index" class="btn btn-primary mt-4">
        <i class="bi bi-house-door"></i> Voltar para o Início
    </a>
</div>
