@model AssistenciaTech.Models.OrdemServico

@{
    ViewData["Title"] = "Atualizar Ordem de Serviço";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow">
                <div class="card-header bg-warning text-dark">
                    <h5 class="mb-0">Atualizar Equipamento - OS #@Model.Id</h5>
                </div>
                <div class="card-body">
                    <form asp-action="Edit" enctype="multipart/form-data">
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                        
                        <!-- Campos ocultos necessários para o Post -->
                        <input type="hidden" asp-for="Id" />
                        <input type="hidden" asp-for="ClienteId" />
                        <input type="hidden" asp-for="DataEntrada" />
                        <input type="hidden" asp-for="DataConclusao" />
                        <input type="hidden" asp-for="DataEntregaCliente" />

                        <div class="row mb-3">
                            <div class="col-md-12">
                                <label class="form-label fw-bold">Cliente</label>
                                <input class="form-control" value="@Model.Cliente?.Nome" disabled />
                                <div class="form-text">O cliente vinculado não pode ser alterado na edição.</div>
                            </div>
                        </div>

                        <div class="row mb-3">
                            <div class="col-md-6 form-group">
                                <label asp-for="Equipamento" class="form-label fw-bold">Equipamento</label>
                                <input asp-for="Equipamento" class="form-control" required />
                                <span asp-validation-for="Equipamento" class="text-danger"></span>
                            </div>
                            <div class="col-md-6 form-group">
                                <label asp-for="NumeroSerie" class="form-label fw-bold">Número de Série (S/N)</label>
                                <input asp-for="NumeroSerie" class="form-control" />
                                <span asp-validation-for="NumeroSerie" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="row mb-3">
                            <div class="col-md-9 form-group">
                                <label asp-for="ProblemaRelatado" class="form-label fw-bold">Problema / Diagnóstico</label>
                                <textarea asp-for="ProblemaRelatado" class="form-control" rows="2" required></textarea>
                                <span asp-validation-for="ProblemaRelatado" class="text-danger"></span>
                            </div>
                            <div class="col-md-3 form-group">
                                <label asp-for="Prioridade" class="form-label fw-bold">Prioridade</label>
                                <select asp-for="Prioridade" class="form-select">
                                    <option value="0">Normal</option>
                                    <option value="1">Alta</option>
                                    <option value="2">Urgente</option>
                                </select>
                                <span asp-validation-for="Prioridade" class="text-danger"></span>
                            </div>
                        </div>
                        
                        <div class="row mb-3">
                            <div class="col-md-12 form-group">
                                <label asp-for="AvariasPreExistentes" class="form-label fw-bold">Avarias Pré-Existentes (Checklist Visual)</label>
                                <textarea asp-for="AvariasPreExistentes" class="form-control" rows="2" placeholder="Descreva arranhões, trincas, peças faltando, etc."></textarea>
                                <span asp-validation-for="AvariasPreExistentes" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="row mb-3">
                            <div class="col-md-6 form-group">
                                <label asp-for="LaudoTecnico" class="form-label fw-bold text-primary">Laudo Técnico (Diagnóstico Oficial)</label>
                                <textarea asp-for="LaudoTecnico" class="form-control border-primary" rows="3" placeholder="Insira o laudo final..."></textarea>
                                <span asp-validation-for="LaudoTecnico" class="text-danger"></span>
                            </div>
                            <div class="col-md-6 form-group">
                                <label asp-for="AnotacoesInternas" class="form-label fw-bold text-info"><i class="bi bi-journal-text"></i> Anotações Internas (Privado)</label>
                                <textarea asp-for="AnotacoesInternas" class="form-control border-info" rows="3" placeholder="Observações apenas para a equipe técnica..."></textarea>
                                <span asp-validation-for="AnotacoesInternas" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="row mb-3">
                            <div class="col-md-6 form-group">
                                <label asp-for="TecnicoId" class="form-label fw-bold">Técnico Responsável</label>
                                <select asp-for="TecnicoId" class="form-select" asp-items="ViewBag.Tecnicos">
                                    <option value="">-- Selecione o Técnico --</option>
                                </select>
                                <span asp-validation-for="TecnicoId" class="text-danger"></span>
                            </div>
                            <div class="col-md-6 form-group">
                                <label asp-for="EquipamentoBackupId" class="form-label fw-bold text-danger">Empréstimo (Aparelho Backup)</label>
                                <select asp-for="EquipamentoBackupId" class="form-select border-danger" asp-items="ViewBag.EquipamentosBackup">
                                    <option value="">-- Nenhum Emprestado --</option>
                                </select>
                                <span asp-validation-for="EquipamentoBackupId" class="text-danger"></span>
                            </div>
                        </div>

                        <!-- SLA e Contratos -->
                        <div class="row mb-3">
                            <div class="col-md-12 form-group">
                                <label asp-for="ContratoId" class="form-label fw-bold text-success">Contrato SLA Vigente</label>
                                <select asp-for="ContratoId" class="form-select border-success" asp-items="ViewBag.Contratos">
                                    <option value="">-- Sem Contrato --</option>
                                </select>
                            </div>
                        </div>

                        <div class="row mb-3">
                            <div class="col-md-6 form-group">
                                <label asp-for="ContadorPaginasInicial" class="form-label fw-bold">Contador Inicial (Impressoras)</label>
                                <input asp-for="ContadorPaginasInicial" type="number" class="form-control" />
                            </div>
                            <div class="col-md-6 form-group">
                                <label asp-for="ContadorPaginasFinal" class="form-label fw-bold">Contador Final (Impressoras)</label>
                                <input asp-for="ContadorPaginasFinal" type="number" class="form-control" />
                            </div>
                        </div>

                        <div class="row mb-3">
                            <div class="col-md-12 form-group">
                                <label class="form-label fw-bold">Evidências (Fotos do Equipamento)</label>
                                <input type="file" name="fotos" class="form-control" accept="image/*" multiple />
                                <div class="form-text">Você pode selecionar múltiplas fotos para comprovar o estado do aparelho.</div>
                                
                                @if (Model.Evidencias != null && Model.Evidencias.Any())
                                {
                                    <div class="mt-3">
                                        <h6>Fotos já enviadas:</h6>
                                        <div class="d-flex flex-wrap gap-2">
                                            @foreach(var ev in Model.Evidencias)
                                            {
                                                <a href="@ev.CaminhoArquivo" target="_blank">
                                                    <img src="@ev.CaminhoArquivo" class="img-thumbnail" style="width: 100px; height: 100px; object-fit: cover;" />
                                                </a>
                                            }
                                        </div>
                                    </div>
                                }
                            </div>
                        </div>

                        <div class="row mb-3">
                            <div class="col-md-12 form-group">
                                <label asp-for="Status" class="form-label fw-bold">Status do Serviço</label>
                                <select asp-for="Status" class="form-select">
                                    <option value="@AssistenciaTech.Models.WorkflowStatus.Recebido">@AssistenciaTech.Models.WorkflowStatus.Recebido</option>
                                    <option value="@AssistenciaTech.Models.WorkflowStatus.EmAnalise">@AssistenciaTech.Models.WorkflowStatus.EmAnalise</option>
                                    <option value="@AssistenciaTech.Models.WorkflowStatus.AguardandoAprovacao">@AssistenciaTech.Models.WorkflowStatus.AguardandoAprovacao</option>
                                    <option value="@AssistenciaTech.Models.WorkflowStatus.AguardandoPecas">@AssistenciaTech.Models.WorkflowStatus.AguardandoPecas</option>
                                    <option value="@AssistenciaTech.Models.WorkflowStatus.EmReparo">@AssistenciaTech.Models.WorkflowStatus.EmReparo</option>
                                    <option value="@AssistenciaTech.Models.WorkflowStatus.Concluido">@AssistenciaTech.Models.WorkflowStatus.Concluido</option>
                                    <option value="@AssistenciaTech.Models.WorkflowStatus.Entregue">@AssistenciaTech.Models.WorkflowStatus.Entregue</option>
                                </select>
                                <span asp-validation-for="Status" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="row mb-3">
                            <div class="col-md-4 form-group">
                                <label asp-for="CustoPecas" class="form-label fw-bold">Custo de Peças (R$)</label>
                                <input asp-for="CustoPecas" type="number" step="0.01" class="form-control custo-input" />
                                <span asp-validation-for="CustoPecas" class="text-danger"></span>
                            </div>
                            <div class="col-md-4 form-group">
                                <label asp-for="CustoMaoDeObra" class="form-label fw-bold">Mão de Obra (R$)</label>
                                <input asp-for="CustoMaoDeObra" type="number" step="0.01" class="form-control custo-input" />
                                <span asp-validation-for="CustoMaoDeObra" class="text-danger"></span>
                            </div>
                            <div class="col-md-4 form-group">
                                <label asp-for="DescontoAplicado" class="form-label fw-bold">Desconto (R$)</label>
                                <input asp-for="DescontoAplicado" type="number" step="0.01" class="form-control custo-input" />
                                <span asp-validation-for="DescontoAplicado" class="text-danger"></span>
                            </div>
                        </div>

                        <!-- Seção de RMA / Terceirizado -->
                        <div class="card bg-light mb-3">
                            <div class="card-body">
                                <h6 class="card-title fw-bold">RMA / Serviço Terceirizado</h6>
                                <div class="form-check form-switch mb-3">
                                    <input class="form-check-input" type="checkbox" asp-for="EnviadoParaTerceiro" id="switchRma">
                                    <label class="form-check-label" for="switchRma">Foi enviado para parceiro/laboratório?</label>
                                </div>
                                <div class="row" id="divRma" style="display: @(Model.EnviadoParaTerceiro ? "flex" : "none")">
                                    <div class="col-md-4 form-group">
                                        <label asp-for="NomeParceiro" class="form-label">Nome do Parceiro</label>
                                        <input asp-for="NomeParceiro" class="form-control" />
                                    </div>
                                    <div class="col-md-4 form-group">
                                        <label asp-for="CustoTerceirizado" class="form-label">Custo (R$)</label>
                                        <input asp-for="CustoTerceirizado" class="form-control" type="number" step="0.01" />
                                    </div>
                                    <div class="col-md-4 form-group">
                                        <label asp-for="PrevisaoRetornoParceiro" class="form-label">Previsão Retorno</label>
                                        <input asp-for="PrevisaoRetornoParceiro" class="form-control" type="date" />
                                    </div>
                                </div>
                            </div>
                        </div>
                        
                        <div class="row mb-3">
                            <div class="col-md-6 text-start">
                                <button type="submit" formaction="/Faturamentos/GerarDaOS?osId=@Model.Id" formmethod="post" class="btn btn-outline-success">
                                    <i class="bi bi-qr-code"></i> Gerar Cobrança PIX
                                </button>
                            </div>
                            <div class="col-md-6 text-end">
                                <h4 class="fw-bold">Total: <span id="valorTotalDisplay" class="text-success">R$ 0,00</span></h4>
                            </div>
                        </div>

                        <hr />
                        <div class="d-flex justify-content-between">
                            <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
                            <button type="submit" class="btn btn-warning"><i class="bi bi-arrow-repeat"></i> Atualizar Ordem</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="~/Views/Shared/_ValidationScriptsPartial.cshtml" />
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const inputs = document.querySelectorAll('.custo-input');
            const totalDisplay = document.getElementById('valorTotalDisplay');

            function calcularTotal() {
                let pecas = parseFloat(document.getElementById('CustoPecas').value) || 0;
                let maoDeObra = parseFloat(document.getElementById('CustoMaoDeObra').value) || 0;
                let desconto = parseFloat(document.getElementById('DescontoAplicado').value) || 0;
                
                let total = (pecas + maoDeObra) - desconto;
                totalDisplay.innerText = total.toLocaleString('pt-BR', { style: 'currency', currency: 'BRL' });
            }

            inputs.forEach(input => {
                input.addEventListener('input', calcularTotal);
            });
            
            calcularTotal();

            // Toggle para os campos de RMA
            const switchRma = document.getElementById('switchRma');
            const divRma = document.getElementById('divRma');
            if(switchRma) {
                switchRma.addEventListener('change', function() {
                    if(this.checked) {
                        divRma.style.display = 'flex';
                    } else {
                        divRma.style.display = 'none';
                    }
                });
            }
        });
    </script>
}
